    "app": {
      "path": "/absolute/path/to/app",
      "allowedUserIds": [
        "YOUR_DISCORD_USER_ID"
      ],
      "teams": {
        "support": {
          "label": "Support",
          "members": ["discord:ANOTHER_DISCORD_USER_ID"],
          "capabilities": "investigator"
        },
        "eng": {
          "label": "Engineering",
          "members": [],
          "capabilities": "builder"
        }
      },
      "discordChannelId": "",
      "discordGuildId": "",
      "repoFetchIntervalMinutes": 5,
      "sla": {
        "critical": { "firstResponseMinutes": 60, "resolutionMinutes": 480 },
        "high": { "firstResponseMinutes": 240, "resolutionMinutes": 2880 },
        "medium": { "firstResponseMinutes": 1440 },
        "low": {}
      },
      "github": {
        "repos": [
          { "owner": "your-org", "repo": "app" }
        ]
      },
      "linear": {
        "enabled": false,
        "apiKey": "",
        "teamKey": "ENG"
      },
      "clickup": {
        "enabled": false,
        "apiKey": "",
        "workspaceId": "",
        "listId": "",
        "customIdPrefix": ""
      },
      "deploy": {
        "enabled": false,
        "environments": {
          "dev": {
            "allowedRefs": ["*"],
            "env": { "K8S_NAMESPACE": "app-dev" }
          },
          "prod": {
            "requireCapability": "approve",
            "allowedRefs": ["main"],
            "env": { "K8S_NAMESPACE": "app-prod", "DB_URL": "" },
            "secretKeys": ["DB_URL"]
          }
        }
      },
      "storage": {
        "gcsBucket": "acme-app-files",
        "prefix": "grokwork",
        "credentialsFile": "/etc/grokwork/gcs-key.json"
      }
    },
    "api": {
      "path": "/absolute/path/to/api",
      "allowedUserIds": [
        "YOUR_DISCORD_USER_ID"
      ]
    }
  },
  "channels": {
    "DISCORD_CHANNEL_ID_FOR_APP": "app",
    "DISCORD_CHANNEL_ID_FOR_API": "api"
  },
