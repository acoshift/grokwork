{{define "content"}}
{{$open := eq .PR.State "OPEN"}}
<p class="pr-crumb">
  <a href="{{if .Project}}/projects/{{.Project}}/ship{{else}}{{route "ship"}}{{end}}">← Ship board</a>
  <span class="crumb-sep">/</span>
  <span class="mono">{{.ActiveOwner}}/{{.ActiveRepo}}#{{.PRNumber}}</span>
</p>
<div class="pr-title-row">
  <h1 id="page-pr-detail">{{if .PR.Title}}{{.PR.Title}}{{else}}{{.ActiveOwner}}/{{.ActiveRepo}}#{{.PRNumber}}{{end}}</h1>
  <div class="pr-head-links">
    <a class="btn btn-compact" href="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/diff{{if .Project}}?project={{urlquery .Project}}{{end}}">View diff</a>
    {{if .PRSessionThreadID}}<a class="btn btn-compact" href="/sessions/{{.PRSessionThreadID}}{{if .Project}}?project={{urlquery .Project}}{{end}}"{{if gt .PRSessionCount 1}} title="{{.PRSessionCount}} sessions bind this PR — opens the most active"{{end}}>Go to session{{if gt .PRSessionCount 1}} ({{.PRSessionCount}}){{end}}</a>{{end}}
    {{if .PR.URL}}<a class="btn btn-compact" href="{{.PR.URL}}" target="_blank" rel="noopener">GitHub ↗</a>{{end}}
  </div>
</div>
<div class="pr-meta">
  {{if eq .PR.State "OPEN"}}<span class="badge live">OPEN</span>{{else if eq .PR.State "MERGED"}}<span class="badge status-merged">MERGED</span>{{else if eq .PR.State "CLOSED"}}<span class="badge status-cancelled">CLOSED</span>{{else if .PR.State}}<span class="badge">{{.PR.State}}</span>{{end}}
  {{if .PR.IsDraft}}<span class="badge">draft</span>{{end}}
  {{if .PR.Author}}<span class="mono">{{.PR.Author}}</span>{{end}}
  {{if .PR.HeadRef}}<span class="mono">{{.PR.HeadRef}} → {{.PR.BaseRef}}</span>{{end}}
  {{if .PR.ChangedFiles}}<span class="mono"><span class="diff-add">+{{.PR.Additions}}</span> <span class="diff-del">−{{.PR.Deletions}}</span> · {{.PR.ChangedFiles}} files</span>{{end}}
</div>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err"{{if .ErrorAlertTitle}} data-app-alert data-app-alert-title="{{.ErrorAlertTitle}}"{{end}}>{{.Error}}</div>{{end}}

{{/* Checks / review / mergeable strip: re-fetch on sse:ship when the PR poller
     updates session store (CI green/fail, state flips). Live gh call on each
     partial so the strip matches GitHub, not the poller cache alone. */}}
<div class="live-region"
     id="live-pr-gates"
     hx-get="/partials/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/gates{{if .Project}}?project={{urlquery .Project}}{{end}}"
     hx-trigger="sse:ship"
     hx-target="this"
     hx-select="unset"
     hx-swap="innerHTML"
     hx-sync="this:queue last">
  {{template "pr_gates" .}}
</div>

<div class="pr-cols">
<div class="pr-main">

<div class="section card">
  <h2>Description</h2>
  {{if .PR.Body}}<div class="md">{{markdown .PR.Body}}</div>{{if .PR.Truncated}}<p class="muted" style="margin:0.6rem 0 0;font-size:0.8rem">Body truncated.</p>{{end}}{{else}}<p class="muted" style="margin:0">No description.</p>{{end}}
</div>

{{/* PR conversation. Distinct from Team review below (grokwork-local verdicts)
     and from inline review threads, which live on the diff. */}}
<div class="section" id="pr-comments">
  <h2>Comments <span class="muted" style="font-weight:500;font-size:0.9rem">({{if .PR.CommentsOmitted}}newest {{len .PR.Comments}} of {{add .PR.CommentsOmitted (len .PR.Comments)}}{{else}}{{len .PR.Comments}}{{end}})</span></h2>
  {{if .PR.CommentsOmitted}}<p class="muted" style="margin:0 0 0.75rem;font-size:0.8rem">{{.PR.CommentsOmitted}} older {{if eq .PR.CommentsOmitted 1}}comment is{{else}}comments are{{end}} on <a href="{{.PR.URL}}" target="_blank" rel="noopener">GitHub ↗</a>.</p>{{end}}
  {{range .PR.Comments}}
  <div class="card" style="margin-bottom:0.75rem;">
    <div class="pr-comment-head">
      <span class="mono">{{if .Author}}{{.Author}}{{else}}unknown{{end}}</span>
      {{if not .CreatedAt.IsZero}}<span class="mono">{{shortTime .CreatedAt}}</span>{{end}}
      {{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener" title="Open on GitHub">↗</a>{{end}}
    </div>
    {{if .Body}}<div class="md" style="margin-top:0.5rem">{{markdown .Body}}</div>{{else}}<p class="muted" style="margin:0.5rem 0 0">(empty)</p>{{end}}
  </div>
  {{else}}
  <div class="empty">No comments on this pull request.</div>
  {{end}}
</div>

<div class="section card" id="pr-team-review">
  <div class="team-review-head">
    <h2>Team review</h2>
    <div class="team-review-status">
      {{if .TeamRollupText}}
      <span class="badge{{if .TeamRollupBadge}} {{.TeamRollupBadge}}{{end}}">{{.TeamRollupText}}</span>
      {{end}}
      {{if .PR.ReviewDecision}}
      <span class="muted team-review-gh">GH <span class="mono">{{.PR.ReviewDecision}}</span></span>
      {{end}}
    </div>
  </div>
  <p class="sub team-review-blurb">Does not satisfy GitHub branch protection.</p>

  {{if .TeamReviews}}
  <div class="table-scroll team-review-history">
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>Reviewer</th>
        <th>Verdict</th>
        <th>Commit</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
    {{range .TeamReviews}}
      <tr>
        <td class="mono nowrap">{{.Review.At.UTC.Format "2006-01-02 15:04"}}</td>
        <td>{{if .Review.ReviewerName}}{{.Review.ReviewerName}}{{else}}<span class="mono">{{.Review.ReviewerID}}</span>{{end}}</td>
        <td class="team-review-verdict">
          <span class="badge{{if .BadgeClass}} {{.BadgeClass}}{{end}}">{{.LabelText}}</span>
          {{if .Fresh}}
          <span class="badge live">fresh</span>
          {{else if .StickyCR}}
          <span class="badge status-error" title="Still blocking until this reviewer re-reviews">blocking</span>
          {{else}}
          <span class="badge">stale</span>
          {{end}}
        </td>
        <td class="mono" title="{{.Review.HeadSHA}}">{{if .HeadShort}}{{.HeadShort}}{{else}}—{{end}}</td>
        <td class="team-review-note">
          {{if .Review.Body}}<span class="clamp">{{.Review.Body}}</span>{{else}}<span class="muted">—</span>{{end}}
          {{if .Review.GHCommentURL}} <a class="team-review-gh-link" href="{{.Review.GHCommentURL}}" target="_blank" rel="noopener">GH ↗</a>{{end}}
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  {{else}}
  <p class="muted team-review-empty">No team reviews yet.</p>
  {{end}}

  {{if .TeamPendingRequests}}
  <div class="team-review-block">
    <h3 class="team-review-h3">Pending requests</h3>
    <div class="table-scroll">
    <table>
      <thead><tr><th>Reviewer</th><th>From</th><th>Note</th>{{if $.CanPRReview}}<th></th>{{end}}</tr></thead>
      <tbody>
      {{range .TeamPendingRequests}}
        <tr>
          <td>{{if .ReviewerName}}{{.ReviewerName}}{{else}}<span class="mono">{{.ReviewerID}}</span>{{end}}</td>
          <td class="muted">{{if .RequesterName}}{{.RequesterName}}{{else if .RequesterID}}<span class="mono">{{.RequesterID}}</span>{{else}}—{{end}}</td>
          <td class="team-review-note">{{if .Note}}{{.Note}}{{else}}<span class="muted">—</span>{{end}}</td>
          {{if $.CanPRReview}}
          <td class="row-actions">
            <form method="post" action="/prs/{{$.ActiveOwner}}/{{$.ActiveRepo}}/{{$.PRNumber}}/review-requests/cancel" class="inline">
              {{template "csrf" $}}
              <input type="hidden" name="project" value="{{$.Project}}">
              <input type="hidden" name="requestId" value="{{.ID}}">
              <button type="submit" class="btn-secondary btn-compact">Cancel</button>
            </form>
          </td>
          {{end}}
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
  </div>
  {{end}}

  {{if not .CanPRReview}}
  <p class="muted team-review-empty" style="margin-top:0.75rem">Requires member role with <span class="mono">prReviews</span> enabled.</p>
  {{end}}
</div>

</div>{{/* /pr-main */}}

{{template "rail_scrim" $}}
<aside class="pr-rail" id="page-rail">
{{template "rail_sheet_head" $}}

{{if and .CanMerge $open}}
<div class="rail-group" id="pr-merge-form">
  <div class="rail-group-title">Ship</div>
  <details class="action"{{if .PRShipReady}} open{{end}}>
    <summary><span class="action-title">Merge pull request</span>{{if .PRShipReady}}<span class="action-hint ok">ready</span>{{else}}<span class="action-hint">gates pending</span>{{end}}</summary>
    <div class="action-body">
      <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/merge" data-confirm="Merge this pull request?" data-confirm-title="Merge pull request" data-confirm-ok="Merge">
        {{template "csrf" $}}
        <input type="hidden" name="project" value="{{.Project}}">
        <div class="field">
          <label for="merge-method">Method</label>
          <select id="merge-method" name="method">
            <option value="squash" {{if eq .WebMergeMethod "squash"}}selected{{end}}>Squash</option>
            <option value="merge" {{if eq .WebMergeMethod "merge"}}selected{{end}}>Merge commit</option>
            <option value="rebase" {{if eq .WebMergeMethod "rebase"}}selected{{end}}>Rebase</option>
          </select>
        </div>
        <label class="check"><input type="checkbox" name="attemptAnyway" value="1"> Attempt even if checks look failing</label>
        <div class="form-actions"><button type="submit">Merge</button></div>
      </form>
    </div>
  </details>
</div>
{{end}}

{{if and .CanPRReview $open}}
<div class="rail-group" id="pr-review-actions">
  <div class="rail-group-title">Review</div>
  <details class="action">
    <summary><span class="action-title">Submit review</span></summary>
    <div class="action-body">
      <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/reviews" id="pr-review-form">
        {{template "csrf" $}}
        <input type="hidden" name="project" value="{{.Project}}">
        <input type="hidden" name="headSha" value="{{.PR.HeadSHA}}">
        <div class="field">
          <label for="verdict">Verdict</label>
          <select id="verdict" name="verdict" required>
            <option value="approved">Approve</option>
            <option value="changes_requested">Request changes</option>
            <option value="commented">Comment only</option>
          </select>
        </div>
        <div class="field">
          <label for="review-body">Message</label>
          <textarea id="review-body" name="body" rows="3" placeholder="Optional for approve; required for request changes"></textarea>
        </div>
        {{if .CanGitHubWrite}}
        <label class="check"><input type="checkbox" name="mirror" value="1" checked> Mirror to GitHub as a PR comment</label>
        {{end}}
        <div class="form-actions"><button type="submit" id="btn-submit-review">Submit</button></div>
      </form>
    </div>
  </details>
  {{if .ReviewerOptions}}
  <details class="action">
    <summary><span class="action-title">Request review</span>{{if .TeamPendingRequests}}<span class="action-hint">{{len .TeamPendingRequests}} pending</span>{{end}}</summary>
    <div class="action-body">
      <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/review-requests" id="pr-request-review-form">
        {{template "csrf" $}}
        <input type="hidden" name="project" value="{{.Project}}">
        <input type="hidden" name="headSha" value="{{.PR.HeadSHA}}">
        <div class="field">
          <label for="reviewerId">Reviewer</label>
          <select id="reviewerId" name="reviewerId" required>
            <option value="">Select teammate…</option>
            {{range .ReviewerOptions}}
            <option value="{{.ID}}">{{.Name}}</option>
            {{end}}
          </select>
        </div>
        <div class="field">
          <label for="review-note">Note (optional)</label>
          <input type="text" id="review-note" name="note" placeholder="What should they focus on?">
        </div>
        <div class="form-actions"><button type="submit" class="btn-secondary" id="btn-request-review">Send request</button></div>
      </form>
    </div>
  </details>
  {{end}}
</div>
{{end}}

{{if .CanStartSession}}
<div class="rail-group" id="pr-address-actions">
  <div class="rail-group-title">Agent</div>
  {{/* Target first, then action. Address CI / Address review used to be repeated
       once per bound session plus once for "fresh", so the same two labels
       appeared up to six times and only the card around them said what they
       differed by. One dropdown carries that difference now. */}}
  <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/address-ci" class="grok-dispatch">
    {{template "csrf" $}}
    <input type="hidden" name="project" value="{{.Project}}">
    {{if .FixHits}}
    <div class="field">
      <label for="dispatch-thread">Session</label>
      <select id="dispatch-thread" name="thread_id">
        {{range .FixHits}}
        <option value="{{.ThreadID}}">Continue {{.Label}}{{if .Busy}} · busy{{end}}{{if .Goal}} — {{.Goal}}{{end}}</option>
        {{end}}
        <option value="__new__">Start a new session</option>
      </select>
    </div>
    {{else}}
    <input type="hidden" name="force_new" value="1">
    {{end}}
    {{/* Model is per-button so each modal names the action it is confirming. The
         select is hidden: the modal clones its options, and with scripting off the
         form still posts the default. */}}
    {{if .CanSelectModel}}<select name="model" hidden>{{template "model_picker_options" $}}</select>{{end}}
    <div class="btn-pair">
      <button type="submit" class="btn-secondary" id="btn-address-ci"
        {{- if .CanSelectModel}} data-confirm="Pushes fixes for the failing checks on this pull request. It never merges." data-confirm-title="Address CI" data-confirm-ok="Start" data-confirm-select="model" data-confirm-select-label="Model (new sessions only)"{{end}}>Address CI</button>
      <button type="submit" class="btn-secondary" id="btn-address-review" formaction="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/address-review"
        {{- if .CanSelectModel}} data-confirm="Works through the unresolved review threads and the PR conversation. It never merges." data-confirm-title="Address review" data-confirm-ok="Start" data-confirm-select="model" data-confirm-select-label="Model (new sessions only)"{{end}}>Address review</button>
    </div>
  </form>
  <p class="rail-note">Pushes fixes to this PR; it never merges. A continued session keeps the model it started on, so the model choice only reaches a new one.</p>
  {{/* Only when several bind: with one, the header's "Go to session" already
       opens it. Labelled by goal — two units on one PR are usually both
       needs_review, so the label alone names them identically. */}}
  {{if gt (len .FixHits) 1}}
  <ul class="rail-links">
    {{range .FixHits}}
    <li><a href="/sessions/{{.ThreadID}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">Open {{if .Goal}}{{.Goal}}{{else}}{{.ThreadID}}{{end}}</a>{{if .Busy}} <span class="badge live">busy</span>{{end}}</li>
    {{end}}
  </ul>
  {{end}}
  {{/* Review is deliberately reuse-free: it re-reads the current head, so it is
       not one of the dropdown's targets. Its own hidden select feeds its own
       confirm modal. */}}
  <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/agent-review" class="grok-dispatch dispatch-next">
    {{template "csrf" $}}
    <input type="hidden" name="project" value="{{.Project}}">
    {{if .CanSelectModel}}<select name="model" hidden>{{template "model_picker_options" $}}</select>{{end}}
    <div class="form-actions">
      <button type="submit" class="btn-secondary" id="btn-review-pr"
        {{- if .CanSelectModel}} data-confirm="Reviews this pull request in a new session and posts the findings as one PR comment." data-confirm-title="Review PR" data-confirm-ok="Start review" data-confirm-select="model" data-confirm-select-label="Review model"{{end}}>Review in new session</button>
    </div>
  </form>
  <p class="rail-note">Always a new session, never one from the dropdown above. Posts findings as a single PR comment — no GitHub issues, no code changes, no merge.</p>
</div>
{{end}}

{{if .CanGitHubWrite}}
<div class="rail-group" id="pr-comment-form">
  <div class="rail-group-title">GitHub</div>
  <details class="action">
    <summary><span class="action-title">Add comment</span></summary>
    <div class="action-body">
      <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/comments">
        {{template "csrf" $}}
        <input type="hidden" name="project" value="{{.Project}}">
        <div class="field">
          <label for="pr-body">Comment</label>
          <textarea id="pr-body" name="body" rows="4" required></textarea>
        </div>
        <div class="form-actions"><button type="submit">Post comment</button></div>
      </form>
    </div>
  </details>
  {{if $open}}
  <details class="action danger" id="pr-close-form">
    <summary><span class="action-title">Close pull request</span></summary>
    <div class="action-body">
      <p class="rail-note">Closes without merging. Managed branches clean up on the next sweep.</p>
      <form method="post" action="/prs/{{.ActiveOwner}}/{{.ActiveRepo}}/{{.PRNumber}}/close" data-confirm="Close this pull request?" data-confirm-title="Close pull request" data-confirm-ok="Close PR" data-confirm-danger>
        {{template "csrf" $}}
        <input type="hidden" name="project" value="{{.Project}}">
        <div class="form-actions"><button type="submit" class="btn-danger">Close</button></div>
      </form>
    </div>
  </details>
  {{end}}
</div>
{{end}}

{{if not (or .CanMerge .CanPRReview .CanStartSession .CanGitHubWrite)}}
<div class="rail-group">
  <div class="rail-group-title">Actions</div>
  <p class="rail-note">Read-only access — merge, review, and starting sessions need a member role with web features enabled.</p>
</div>
{{end}}

</aside>
</div>{{/* /pr-cols */}}
{{end}}

{{define "pr_gates"}}
{{if .PRGates}}
<div class="pr-gates">
  {{range .PRGates}}
  <div class="pr-gate{{if .Class}} {{.Class}}{{end}}">
    <div class="gate-label">{{.Label}}</div>
    <div class="gate-value">{{.Value}}</div>
    {{if .Hint}}<div class="gate-hint">{{.Hint}}</div>{{end}}
  </div>
  {{end}}
</div>
{{end}}
{{end}}
