{{define "content"}}
{{/* Crumb target is provenance-aware (see sessionBackLink): the board the user
     came from, the case board for a case, the sessions list otherwise. */}}
<p class="pr-crumb">
  <a href="{{.BackHref}}">← {{.BackLabel}}</a>
  <span class="crumb-sep">/</span>
  <span class="mono">{{.ThreadID}}</span>
</p>
<div class="pr-title-row">
  <h1 id="page-session">Session <span class="mono" style="font-weight:500;font-size:1.05rem;color:var(--muted)">{{.ThreadID}}</span></h1>
  <div class="pr-head-links">
    {{/* No "Case board" button: for a case the ← crumb already goes there,
         and two back-links to the same board read as two destinations. */}}
    {{if .HasWorktree}}
    <a class="btn btn-compact" href="/sessions/{{.ThreadID}}/diff{{if .Project}}?project={{urlquery .Project}}{{end}}">Worktree diff</a>
    {{else}}
    <a class="btn btn-compact" href="/sessions/{{.ThreadID}}/diff{{if .Project}}?project={{urlquery .Project}}{{end}}" aria-disabled="true" title="Worktree no longer on disk">Worktree diff</a>
    {{end}}
    {{range .SessionEntry.PRs}}
    {{if and .Owner .Repo .Number}}
    <a class="btn btn-compact" href="/prs/{{.Owner}}/{{.Repo}}/{{.Number}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">PR #{{.Number}}</a>
    {{else if .URL}}
    <a class="btn btn-compact" href="{{.URL}}" target="_blank" rel="noopener">PR{{if .Number}} #{{.Number}}{{end}} ↗</a>
    {{end}}
    {{end}}
    <a class="btn btn-compact" href="/history/{{.ThreadID}}{{if .Project}}?project={{urlquery .Project}}{{end}}">Turn log</a>
    {{if .DiscordURL}}<a class="btn btn-compact" href="{{.DiscordURL}}" target="_blank" rel="noopener">Discord ↗</a>{{end}}
  </div>
</div>
{{if or .Project .SessionSpend.Turns}}
<div class="pr-meta">
  {{if .Project}}<span><strong>{{.Project}}</strong></span>{{end}}
  {{/* Sessions started before agents were selectable carry no stamp; showing
       nothing there is accurate, since they ran on whatever the default was. */}}
  {{if .SessionEntry.Agent}}<span class="badge" id="session-agent">{{.SessionEntry.Agent}}{{if .SessionEntry.Model}} · {{.SessionEntry.Model}}{{end}}</span>{{end}}
  {{if .SessionEntry.IsCase}}
  <span class="badge">case</span>
  {{if .SessionEntry.Phase}}<span class="badge">{{.SessionEntry.Phase}}</span>{{end}}
  {{end}}
  {{/* What this session has cost, on the identity row rather than a line of its
       own: it is a property of the unit, like its project and model, and a second
       .pr-meta row reads as an orphan under the first.
       Deliberately outside the live region — it is folded from the *sealed* turn
       log, so it cannot change while a run is in flight, and re-rendering it on
       every dashboard tick would be pure noise. Cost is "—" rather than $0.00
       when no model here has a rate; see spendCost. */}}
  {{if .SessionSpend.Turns}}
  <span id="session-spend" title="Sum of every turn's billed tokens in this session">{{tokens .SessionSpend.TotalTokens}} tokens</span>
  <span title="{{if .SessionSpend.HasCost}}{{if .SessionSpend.Partial}}A floor: {{.SessionSpend.Unpriced}} turn(s) ran on a model with no rate{{else}}Priced from the configured model rates{{end}}{{else}}No rate configured for this session's model{{end}}">{{cost .SessionSpend}}</span>
  <span class="muted">{{.SessionSpend.Turns}} billed turn{{if ne .SessionSpend.Turns 1}}s{{end}}</span>
  {{end}}
</div>
{{end}}
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}
{{if .ErrorGrokBanner}}<div class="flash" id="error-grok-banner">{{.ErrorGrokBannerCopy}}</div>{{end}}

<div class="pr-cols">
<div class="pr-main">

{{/* Live work-unit + turns: dashboard ticks while a run is active (elapsed + stream text);
     history fires when a turn is sealed into the log. Continue form stays in the rail so SSE
     swaps do not wipe in-progress prompt text. */}}
<div class="live-region"
     id="live-session"
     hx-get="/partials/sessions/{{.ThreadID}}{{if .NavProject}}?project={{urlquery .NavProject}}{{else if .Project}}?project={{urlquery .Project}}{{end}}"
     hx-trigger="sse:dashboard, sse:history"
     hx-target="this"
     hx-select="unset"
     hx-swap="innerHTML show:none focus-scroll:false"
     hx-sync="this:queue last">
  {{template "session_live" .}}
</div>

{{if and .HasSession .CanStartSession (not .SessionEntry.IsCaseClosed)}}
{{/* Docked conversation composer. Closed cases hide it until reopen —
     the web continue endpoint rejects them. Lives OUTSIDE #live-session on purpose:
     SSE swaps must never wipe an in-progress prompt (the live-partial tests
     pin session-continue-form out of the fragment). Desktop: sticky at the
     bottom of the conversation column. Phone: fixed bottom bar replacing the
     tab bar on this page (see the :has(#page-session) rules in layout). */}}
{{/* Support-phase cases (intake/investigate/answered): investigate-oriented copy.
     Eng phases and non-case sessions keep the generic follow-up wording — freeform
     can ship there, so "Never opens PRs" would be a product lie. */}}
{{$caseInvestigate := and .SessionEntry.IsCase (not .SessionEntry.IsCaseClosed) (not .SessionEntry.IsCaseShipPhase)}}
<div class="composer-dock" id="session-continue-form">
  <form method="post" action="/sessions/{{.ThreadID}}/continue" enctype="multipart/form-data" class="composer">
    {{template "csrf" $}}
    <label for="continue-prompt" class="sr-only">Prompt</label>
    <textarea id="continue-prompt" name="prompt" rows="1" required placeholder="{{if $caseInvestigate}}What should the agent look into?{{else}}What should happen next?{{end}}"></textarea>
    <button type="button" class="composer-attach" id="btn-attach" title="Attach images" aria-label="Attach images">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
    </button>
    <input type="file" id="continue-images" name="images" accept="image/*" multiple hidden data-attach-chips="continue-attach-chips" data-attach-button="btn-attach">
    <button type="submit" id="btn-continue" class="composer-send" title="Send follow-up" aria-label="Send follow-up">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
    </button>
  </form>
  <div class="attach-chips" id="continue-attach-chips" hidden></div>
  <p class="composer-hint"><span>{{if $caseInvestigate}}Queues a read-only investigate on this case. Never opens PRs.{{else}}Queues a follow-up on this session.{{end}}</span><span class="composer-kbd"><kbd>⌘</kbd><kbd>↩</kbd> send</span></p>
</div>
{{end}}

</div>{{/* /pr-main */}}

{{template "rail_scrim" $}}
<aside class="pr-rail" id="page-rail">
{{template "rail_sheet_head" $}}

{{if and .SessionEntry.IsCase (or .CanCaseEscalate .CanCaseAnswer .CanCaseDraft .CanCaseClose .CanCaseReopen .CanLinkCase)}}
{{/* Case phase forms stay outside the live region so SSE swaps do not wipe typed notes.
     Agent investigate runs go through the docked composer (POST …/continue), not a rail form. */}}
<div class="rail-group" id="session-case-actions">
  <div class="rail-group-title">Case</div>
  {{if .CanCaseReopen}}
  <details class="action" open>
    <summary><span class="action-title">Reopen case</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/case/reopen">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-reopen-phase">Resume phase</label>
          <select id="case-reopen-phase" name="phase">
            <option value="investigate" selected>investigate</option>
            <option value="fixing">fixing</option>
          </select>
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-reopen" class="btn-secondary">Reopen case</button></div>
      </form>
      <p class="rail-note" style="margin-top:0.55rem">Clears resolution; keeps the dossier.</p>
    </div>
  </details>
  {{end}}
  {{if .CanCaseEscalate}}
  <details class="action">
    <summary><span class="action-title">Escalate to eng</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/case/escalate">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-escalate-note">Note for eng <span class="muted">(optional)</span></label>
          <textarea id="case-escalate-note" name="note" rows="2" placeholder="Repro, IDs, what you already ruled out"></textarea>
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-escalate" class="btn-secondary">Escalate → fixing</button></div>
      </form>
    </div>
  </details>
  {{end}}
  {{if .CanCaseAnswer}}
  <details class="action">
    <summary><span class="action-title">Answer</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/case/answer">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-answer-note">Draft for customer <span class="muted">(optional)</span></label>
          <textarea id="case-answer-note" name="note" rows="2" placeholder="Safe wording for the customer"></textarea>
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-answer" class="btn-secondary">Mark answered</button></div>
      </form>
    </div>
  </details>
  {{end}}
  {{if .CanCaseDraft}}
  <details class="action">
    <summary><span class="action-title">Customer update</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/case/customer-update">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-customer-text">Customer-facing text</label>
          <textarea id="case-customer-text" name="text" rows="3" required placeholder="What you can send the customer">{{.SessionEntry.CustomerUpdate}}</textarea>
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-customer">Save update</button></div>
      </form>
      <p class="rail-note" style="margin-top:0.55rem">Sanitizer redacts secrets and local paths.</p>
    </div>
  </details>
  {{end}}
  {{if .CanLinkCase}}
  <details class="action">
    <summary><span class="action-title">Related cases</span>{{if .CaseLinks}}<span class="action-hint">{{len .CaseLinks}}</span>{{end}}</summary>
    <div class="action-body">
      {{/* Only outbound links get a Remove: an inbound one is the other case's
           sentence about this one, and is theirs to retract. */}}
      {{range .CaseLinks}}{{if not .Inbound}}
      <form method="post" action="/sessions/{{$.ThreadID}}/case/unlink" class="case-link-row">
        {{template "csrf" $}}
        <input type="hidden" name="caseKey" value="{{.CaseKey}}">
        <span class="mono">{{.CaseKey}}</span>
        {{if .Title}}<span class="muted case-link-title">{{.Title}}</span>{{end}}
        <button type="submit" class="btn-danger btn-compact">Remove</button>
      </form>
      {{end}}{{end}}
      <form method="post" action="/sessions/{{.ThreadID}}/case/link">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-link-key">Case id</label>
          <input type="text" id="case-link-key" name="caseKey" required placeholder="{{if .SessionEntry.CaseKey}}e.g. {{.SessionEntry.CaseKey}}{{else}}e.g. WEBAPP-14{{end}}" autocapitalize="characters" autocomplete="off" spellcheck="false">
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-link" class="btn-secondary">Link case</button></div>
      </form>
      <p class="rail-note" style="margin-top:0.55rem">The other case shows this one back automatically.</p>
    </div>
  </details>
  {{end}}
  {{if .CanCaseClose}}
  <details class="action">
    <summary><span class="action-title">Close case</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/case/close" data-confirm="Close this case? You can reopen it later with Reopen case." data-confirm-title="Close case" data-confirm-ok="Close case">
        {{template "csrf" $}}
        <div class="field">
          <label for="case-resolution">Resolution</label>
          <select id="case-resolution" name="resolution">
            <option value="answered">answered</option>
            <option value="fixed">fixed</option>
            <option value="duplicate">duplicate</option>
            <option value="wontfix">wontfix</option>
            <option value="escalated_external">escalated_external</option>
          </select>
        </div>
        <div class="field">
          <label for="case-close-note">Note <span class="muted">(optional)</span></label>
          <input type="text" id="case-close-note" name="note" placeholder="Short resolution note">
        </div>
        <div class="form-actions"><button type="submit" id="btn-case-close" class="btn-danger">Close case</button></div>
      </form>
    </div>
  </details>
  {{end}}
</div>
{{end}}

{{if and .CanStartSession .HasSession}}
{{if not .SessionEntry.IsCaseClosed}}
<div class="rail-group" id="session-lifecycle">
  <div class="rail-group-title">Lifecycle</div>
  <details class="action">
    <summary><span class="action-title">Label</span></summary>
    <div class="action-body">
      {{$cur := .SessionEntry.EffectiveLabel}}{{$manual := .SessionEntry.LabelManual}}
      <form method="post" action="/sessions/{{.ThreadID}}/label">
        {{template "csrf" $}}
        <div class="field">
          <label for="session-label">Label</label>
          <select id="session-label" name="label">
            <option value="open"{{if and $manual (eq $cur "open")}} selected{{end}}>open</option>
            <option value="in_progress"{{if and $manual (eq $cur "in_progress")}} selected{{end}}>in progress</option>
            <option value="blocked"{{if and $manual (eq $cur "blocked")}} selected{{end}}>blocked</option>
            <option value="needs_review"{{if and $manual (eq $cur "needs_review")}} selected{{end}}>needs review</option>
            <option value="done"{{if and $manual (eq $cur "done")}} selected{{end}}>done</option>
            <option value="abandoned"{{if and $manual (eq $cur "abandoned")}} selected{{end}}>abandoned</option>
            <option value="auto"{{if not $manual}} selected{{end}}>auto</option>
          </select>
        </div>
        <div class="form-actions"><button type="submit" id="btn-label">Apply label</button></div>
      </form>
    </div>
  </details>
  <details class="action">
    <summary><span class="action-title">Goal</span></summary>
    <div class="action-body">
      <form method="post" action="/sessions/{{.ThreadID}}/goal">
        {{template "csrf" $}}
        <div class="field">
          <label for="session-goal">Sticky goal</label>
          <input type="text" id="session-goal" name="goal" maxlength="200" value="{{.SessionEntry.Goal}}" placeholder="One-line goal for this unit">
        </div>
        <div class="form-actions"><button type="submit" id="btn-goal">Save goal</button></div>
      </form>
    </div>
  </details>
</div>

{{end}}

<div class="rail-group" id="session-ownership">
  <div class="rail-group-title">Ownership</div>
  <p class="rail-note">{{if .SessionEntry.OwnerName}}Owner: <strong>{{.SessionEntry.OwnerName}}</strong>{{else}}Unowned — any member may control it.{{end}}{{if .SessionEntry.CoOwnerIDs}} · {{len .SessionEntry.CoOwnerIDs}} co-owner(s){{end}}</p>
  {{/* Claim is for active lockout-breaking only — hide on terminal units. */}}
  {{$ownLab := .SessionEntry.EffectiveLabel}}
  {{if and (not (.SessionEntry.IsOwner .UserID)) (ne $ownLab "done") (ne $ownLab "abandoned")}}
  <form method="post" action="/sessions/{{.ThreadID}}/claim"{{if .SessionEntry.HasOwner}} data-confirm="Take over ownership? The current owner becomes a co-owner." data-confirm-title="Take over ownership" data-confirm-ok="Take over"{{end}}>
    {{template "csrf" $}}
    <div class="form-actions"><button type="submit" id="btn-claim" class="btn-secondary">Claim ownership</button></div>
  </form>
  {{end}}
</div>
{{else if .CanStartSession}}
<div class="rail-group">
  <div class="rail-group-title">Actions</div>
  <p class="rail-note">This session is no longer active.{{if .Project}} <a href="/projects/{{.Project}}/start">Start a new task</a>.{{end}}</p>
</div>
{{else}}
<div class="rail-group">
  <div class="rail-group-title">Actions</div>
  <p class="rail-note">Read-only access — continuing this work unit needs a member role with <span class="mono">startSessions</span> enabled.</p>
</div>
{{end}}

{{/* Web-only: terminal units (done/abandoned) need no close-out zone — worktree
     cleanup is automatic after ship/PR close. Active units get Mark as done
     (label only, via /label) and Abandon (same /reset backend as Discord /reset). */}}
{{if and .CanControlSession .HasSession}}
{{$lab := .SessionEntry.EffectiveLabel}}
{{if and (ne $lab "done") (ne $lab "abandoned")}}
<div class="rail-group" id="session-danger">
  <div class="rail-group-title">Close out</div>
  <form method="post" action="/sessions/{{.ThreadID}}/label" data-confirm="Mark this session as done? PR links and history stay; worktree cleanup still follows terminal PRs / idle TTL." data-confirm-title="Mark as done" data-confirm-ok="Mark as done">
    {{template "csrf" $}}
    <input type="hidden" name="label" value="done">
    <div class="form-actions"><button type="submit" id="btn-mark-done" class="btn-secondary">Mark as done</button></div>
  </form>
  <p class="rail-note">Ships the lifecycle label only — does not wipe the worktree.</p>
  <form method="post" action="/sessions/{{.ThreadID}}/reset" data-confirm="Abandon this session? Removes the worktree and managed branch, and clears the session. This cannot be undone." data-confirm-title="Abandon session" data-confirm-ok="Abandon" data-confirm-danger>
    {{template "csrf" $}}
    <div class="form-actions"><button type="submit" id="btn-abandon" class="btn-danger"{{if .RunBusy}} disabled title="Cancel the active run before abandoning"{{end}}>Abandon</button></div>
  </form>
  <p class="rail-note">Removes worktree and branch. History stays.</p>
</div>
{{end}}
{{end}}

</aside>
</div>{{/* /pr-cols */}}
{{end}}

{{define "session_live"}}
{{/* Completion summary from the unit's run record. On Discord this is a card in
     the thread; a web-native unit has no thread, so this is the only place it
     appears. */}}
{{if .Completion}}
<div class="section card" id="session-completion-panel">
  <h2>Last completion</h2>
  <p class="sub" style="margin:0">
    <span class="badge">{{.Completion.Status}}</span>
    {{if .Completion.Branch}} <span class="mono">{{.Completion.Branch}}</span>{{end}}
    {{if .Completion.Diff.FileCount}} · {{.Completion.Diff.FileCount}} file{{if ne .Completion.Diff.FileCount 1}}s{{end}}{{end}}
    {{if .Completion.Diff.Insertions}} · <span class="diff-add">+{{.Completion.Diff.Insertions}}</span>{{end}}
    {{if .Completion.Diff.Deletions}} · <span class="diff-del">-{{.Completion.Diff.Deletions}}</span>{{end}}
    {{if .Completion.Diff.Dirty}} · <span class="badge status-error">uncommitted</span>{{end}}
  </p>
  {{if .Completion.Diff.Risky}}
  <p class="sub" style="margin:0.35rem 0 0">Risky paths: {{range $i, $p := .Completion.Diff.Risky}}{{if $i}}, {{end}}<span class="mono">{{$p}}</span>{{end}}</p>
  {{end}}
</div>
{{end}}
{{if .SessionEntry.LastVerify}}
<div class="section card" id="session-verify-panel">
  <h2>Last verify</h2>
  <p class="sub" style="margin:0">
    {{if .SessionEntry.LastVerify.OK}}<span class="badge status-done">pass</span>{{else}}<span class="badge status-error">fail</span>{{end}}
    {{if .SessionEntry.LastVerify.Name}} <span class="mono">{{.SessionEntry.LastVerify.Name}}</span>{{end}}
    {{if .SessionEntry.LastVerify.At}} · <span class="mono muted">{{shortTime .SessionEntry.LastVerify.At}}</span>{{end}}
    {{if not .SessionEntry.LastVerify.OK}} · exit <span class="mono">{{.SessionEntry.LastVerify.ExitCode}}</span>{{end}}
  </p>
  {{if .SessionEntry.LastVerify.Summary}}
  <p class="muted" style="margin:0.55rem 0 0">{{.SessionEntry.LastVerify.Summary}}</p>
  {{end}}
  {{if and (not .SessionEntry.LastVerify.OK) .SessionEntry.LastVerify.LogTail}}
  <pre class="mono" style="margin:0.65rem 0 0;padding:0.65rem;background:var(--surface-2);border-radius:6px;font-size:0.78rem;overflow:auto;max-height:12rem;white-space:pre-wrap">{{.SessionEntry.LastVerify.LogTail}}</pre>
  {{end}}
</div>
{{end}}

{{if .SessionEntry.IsCase}}
<div class="section card" id="session-case-panel">
  <h2>Case <span class="muted" style="font-weight:500;font-size:0.9rem">· {{if .SessionEntry.Phase}}{{.SessionEntry.Phase}}{{else}}intake{{end}}</span></h2>
  <p class="sub" style="margin:0">
    {{if .SessionEntry.CaseKey}}<span class="mono case-key" id="session-case-key">{{.SessionEntry.CaseKey}}</span>{{end}}
    <span class="badge">case</span>
    {{if .SessionEntry.Phase}}<span class="badge">{{.SessionEntry.Phase}}</span>{{end}}
    {{if .SessionEntry.Severity}}<span class="badge sev-{{.SessionEntry.Severity}}">{{.SessionEntry.Severity}}</span>{{end}}
    {{if .CaseSLA.Badge}}<span class="badge{{if .CaseSLA.Breached}} status-error{{else if .CaseSLA.Held}} status-warn{{end}}" id="session-case-sla" title="{{.CaseSLA.Detail}}">{{.CaseSLA.Badge}}</span>{{end}}
    {{if .SessionEntry.IsCaseClosed}}<span class="badge">closed</span>{{end}}
  </p>
  {{if .CaseLinks}}
  {{/* Outbound and inbound in one list: from a reader's point of view both
       answer "what else is this connected to". The direction is a chip, not a
       heading, so a case with one of each does not grow two sections. */}}
  <p style="margin:0.85rem 0 0.25rem"><span class="bubble-label" style="display:block">Related cases</span></p>
  <ul class="case-links">
    {{range .CaseLinks}}
    <li>
      {{if .ThreadID}}
      <a class="mono" href="/sessions/{{.ThreadID}}{{if .Project}}?project={{urlquery .Project}}{{end}}">{{.CaseKey}}</a>
      {{else}}
      <span class="mono muted" title="This case no longer exists">{{.CaseKey}}</span>
      {{end}}
      {{if .Inbound}}<span class="badge">references this</span>{{end}}
      {{if .Phase}}<span class="badge">{{.Phase}}</span>{{end}}
      {{if .Title}}<span class="muted">— {{.Title}}</span>{{end}}
    </li>
    {{end}}
  </ul>
  {{end}}
  {{if .SessionEntry.CustomerTitle}}
  <p style="margin:0.85rem 0 0"><span class="bubble-label" style="display:block">Title</span>{{.SessionEntry.CustomerTitle}}</p>
  {{end}}
  <p class="sub" style="margin:0.5rem 0 0">
    {{if .SessionEntry.CustomerRef}}ref <span class="mono">{{.SessionEntry.CustomerRef}}</span> · {{end}}
    {{if .SessionEntry.ReporterName}}reporter {{.SessionEntry.ReporterName}}{{else if .SessionEntry.ReporterID}}reporter <span class="mono">{{.SessionEntry.ReporterID}}</span>{{end}}
    {{if .SessionEntry.IntakeSource}} · via <span class="mono">{{.SessionEntry.IntakeSource}}</span>{{end}}
    {{if .SessionEntry.Resolution}} · resolution <span class="mono">{{.SessionEntry.Resolution}}</span>{{end}}
  </p>
  {{if .SessionEntry.CustomerUpdate}}
  <p style="margin:0.85rem 0 0"><span class="bubble-label" style="display:block">Customer update</span>{{.SessionEntry.CustomerUpdate}}</p>
  {{end}}
  {{if .SessionEntry.Dossier}}
  {{if .SessionEntry.Dossier.Summary}}
  <p style="margin:0.85rem 0 0"><span class="bubble-label" style="display:block">Dossier</span>{{.SessionEntry.Dossier.Summary}}</p>
  {{end}}
  {{if .SessionEntry.Dossier.NextActions}}
  <p style="margin:0.55rem 0 0"><span class="bubble-label" style="display:block">Next actions</span>
    {{range $i, $a := .SessionEntry.Dossier.NextActions}}{{if $i}}; {{end}}{{$a}}{{end}}
  </p>
  {{end}}
  {{end}}
</div>
{{end}}

<div class="section card">
  <h2>Work unit</h2>
  <p class="sub" style="margin:0">
    {{$lab := .SessionEntry.EffectiveLabel}}
    {{if .SessionEntry.IsCaseClosed}}
    <span class="badge status-cancelled">closed</span>
    {{if .SessionEntry.Resolution}}{{if or (eq .SessionEntry.Resolution "answered") (eq .SessionEntry.Resolution "fixed")}}<span class="badge status-done">{{.SessionEntry.Resolution}}</span>{{else}}<span class="badge status-cancelled">{{.SessionEntry.Resolution}}</span>{{end}}{{end}}
    {{else if eq $lab "done"}}
    <span class="badge status-done">done</span>
    {{else if eq $lab "abandoned"}}
    <span class="badge status-cancelled">abandoned</span>
    {{else if eq $lab "needs_review"}}
    <span class="badge status-warn">needs review</span>
    {{else if eq $lab "in_progress"}}
    <span class="badge live">in progress</span>
    {{else if eq $lab "blocked"}}
    <span class="badge status-warn">blocked</span>
    {{else}}
    <span class="badge">{{$lab}}</span>
    {{end}}
    {{if .RunBusy}} <span class="badge live">running</span>{{if .RunElapsed}} <span class="mono muted">{{.RunElapsed}}</span>{{end}}{{end}}
    {{if .SessionEntry.Origin}} · origin <span class="mono">{{.SessionEntry.Origin}}</span>{{end}}
    {{if .SessionEntry.OwnerName}} · owner {{.SessionEntry.OwnerName}}{{end}}
    {{if .SessionEntry.WorktreeBranch}} · branch <span class="mono">{{.SessionEntry.WorktreeBranch}}</span>{{end}}
    {{if and (not .HasWorktree) (or .SessionEntry.IsCaseClosed (eq $lab "done") (eq $lab "abandoned") .SessionEntry.AllPRsTerminal)}} · <span class="muted">worktree cleaned</span>{{end}}
  </p>
  {{if and .RunBusy .CanControlSession}}
  {{/* Button-only form is the sanctioned live-region exception: it holds no typed
       input, so an SSE swap between render and submit at worst flashes "no active run".
       Never place text/textarea inputs inside a live region — refreshes wipe them. */}}
  <form method="post" action="/sessions/{{.ThreadID}}/cancel" style="margin:0.6rem 0 0">
    {{template "csrf" $}}
    <button type="submit" id="btn-cancel-run" class="btn-danger btn-compact">Cancel run</button>
  </form>
  {{end}}
  {{if .SessionEntry.Goal}}
  <p style="margin:0.85rem 0 0"><span class="bubble-label" style="display:block">Goal</span>{{.SessionEntry.Goal}}</p>
  {{end}}
  {{if .QueueItems}}
  <p style="margin:0.85rem 0 0.25rem"><span class="bubble-label" style="display:block">Queue ({{len .QueueItems}})</span></p>
  <ul class="queue-list" style="margin:0;padding-left:1.25rem">
    {{range .QueueItems}}
    <li>
      <span class="mono muted">#{{.Position}}</span>
      {{if .AuthorName}}<strong>{{.AuthorName}}</strong>{{end}}
      {{if .Intent}}<span class="muted">— {{.Intent}}</span>{{end}}
      {{if and $.CanStartSession (or (eq .AuthorID $.UserID) $.CanControlSession)}}
      <form method="post" action="/sessions/{{$.ThreadID}}/queue/remove" style="display:inline;margin-left:0.4rem">
        {{template "csrf" $}}
        <input type="hidden" name="task_id" value="{{.TaskID}}">
        <button type="submit" class="btn-danger btn-compact">Remove</button>
      </form>
      {{end}}
    </li>
    {{end}}
  </ul>
  {{end}}
  {{if .SessionEntry.PRs}}
  <p style="margin:0.85rem 0 0.25rem"><span class="bubble-label" style="display:block">Pull requests</span></p>
  <ul style="margin:0;padding-left:1.25rem">
    {{range .SessionEntry.PRs}}
    <li>
      {{if and .Owner .Repo .Number}}
      <a class="mono" href="/prs/{{.Owner}}/{{.Repo}}/{{.Number}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">{{.Owner}}/{{.Repo}}#{{.Number}}</a>
      {{else if .Number}}
      <span class="mono">#{{.Number}}</span>
      {{else if .URL}}
      <a class="mono" href="{{.URL}}" target="_blank" rel="noopener">{{.URL}}</a>
      {{else}}
      <span class="muted">PR</span>
      {{end}}
      {{if eq .State "OPEN"}}
      <span class="badge live">{{.State}}</span>
      {{else if eq .State "MERGED"}}
      <span class="badge status-merged">{{.State}}</span>
      {{else if eq .State "CLOSED"}}
      <span class="badge status-cancelled">{{.State}}</span>
      {{else if .State}}
      <span class="badge">{{.State}}</span>
      {{end}}
      {{if .IsDraft}} <span class="badge">draft</span>{{end}}
      {{if .Title}} <span class="muted">— {{.Title}}</span>{{end}}
      {{if and .URL .Owner .Repo .Number}} <a href="{{.URL}}" target="_blank" rel="noopener" title="Open on GitHub">↗</a>{{end}}
    </li>
    {{end}}
  </ul>
  {{end}}
  {{if .SessionEntry.Issues}}
  <p style="margin:0.85rem 0 0.25rem"><span class="bubble-label" style="display:block">Bound issues</span></p>
  <ul style="margin:0;padding-left:1.25rem">
    {{range .SessionEntry.Issues}}
    <li class="mono">{{.DisplayRef}} ({{.EffectiveKeyword}})</li>
    {{end}}
  </ul>
  {{end}}
  {{if .RunBusy}}
  {{if .RunPhases}}<p class="mono" style="margin:0.85rem 0 0">{{.RunPhases}}</p>{{end}}
  {{if .RunActivity}}<p class="muted" style="margin:0.35rem 0 0"><em>{{.RunActivity}}</em></p>{{end}}
  {{else}}
  <p class="muted" style="margin:0.85rem 0 0">No active {{.AgentLabel}} run.</p>
  {{end}}
</div>

<div class="section">
  {{$done := len .Thread.Turns}}
  <h2>Turns <span class="muted" style="font-weight:500;font-size:0.9rem">({{if .RunBusy}}{{add $done 1}}{{else}}{{$done}}{{end}})</span></h2>
  {{if or .Thread.Turns .RunBusy}}
  <div class="turns" id="turns">
    {{/* Newest first: the live/latest turn sits at the top next to the page
         header, so long histories never bury it. #N stays chronological.
         Within a turn the agent reply is above the user prompt.
         The docked composer is position-pinned, so it needs no scrolling. */}}
    {{if .RunBusy}}
    <article class="turn turn-live" id="turn-live">
      <header class="turn-meta">
        <span class="mono muted">#{{add $done 1}}</span>
        <span class="badge live">streaming</span>
        {{if .RunElapsed}}<span class="mono muted">{{.RunElapsed}}</span>{{end}}
      </header>
      <div class="bubble assistant">
        <div class="bubble-label">{{.AgentLabel}} <span class="muted" style="font-weight:500;text-transform:none;letter-spacing:0">(live)</span></div>
        {{if .RunLiveText}}
        <div class="bubble-body md" id="live-stream-body">{{markdown .RunLiveText}}</div>
        {{else}}
        <div class="bubble-body muted" id="live-stream-body">streaming…</div>
        {{end}}
      </div>
      {{if .RunPrompt}}
      <div class="bubble user">
        <div class="bubble-label">User</div>
        <div class="bubble-body md">{{markdown .RunPrompt}}</div>
      </div>
      {{end}}
    </article>
    {{end}}
    {{$turns := .Thread.Turns}}
    {{$n := len $turns}}
    {{range $i, $_ := $turns}}
    {{$ri := sub (sub $n 1) $i}}
    {{with $t := index $turns $ri}}
    <article class="turn">
      <header class="turn-meta">
        <span class="mono muted">#{{add $ri 1}}</span>
        <span class="badge status-{{$t.Status}}">{{$t.Status}}</span>
        {{if $t.User}}<span>{{$t.User}}</span>{{end}}
      </header>
      <div class="bubble assistant">
        <div class="bubble-label">{{$.AgentLabel}}</div>
        {{if $t.Response}}
        <div class="bubble-body md">{{markdown $t.Response}}</div>
        {{else if and (eq $ri (sub $n 1)) $.RunTranscript}}
        <div class="bubble-body md">{{markdown $.RunTranscript}}</div>
        <div class="bubble-note muted">Recovered from the run record — this run ended without a final reply.</div>
        {{else}}
        <div class="bubble-body muted">(no response text yet)</div>
        {{end}}
      </div>
      <div class="bubble user">
        <div class="bubble-label">User</div>
        <div class="bubble-body md">{{markdown $t.Prompt}}</div>
      </div>
    </article>
    {{end}}
    {{end}}
  </div>
  {{else}}
  <div class="empty">No turns yet.</div>
  {{end}}
</div>
{{end}}
