{{define "content"}}
{{$run := .DeployRun}}
<h1 id="page-deploy-run">
  <span class="mono">{{$run.Service}}</span> → <span class="mono">{{$run.Env}}</span>
</h1>
<p class="sub">
  <a href="/projects/{{.Project}}/deploys">deploys</a>
  <span class="crumb-sep">/</span>
  <span class="mono">{{$run.ShortSHA}}</span>
  {{if $run.Ref}} · ref <span class="mono">{{$run.Ref}}</span>{{end}}
  {{if $run.ActorName}} · by {{$run.ActorName}}{{end}}
  {{if $run.RedeployOf}} · <span class="flag">redeploy</span>{{end}}
  {{if eq $run.RefCheck "waived_redeploy"}} · <span class="flag" title="This commit already passed the ref gate on this lane">ref check waived</span>{{end}}
</p>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{/* Action forms live OUTSIDE the live region below: the confirm handler bails
     on a detached form (it checks isConnected), and the swap-pause hook only
     fires for isEditing(), which does not cover an open dialog. A confirmed
     prod deploy silently doing nothing is the failure this avoids. */}}
<div class="toolbar" id="deploy-run-actions">
  {{if not $run.Status.Terminal}}
  <form method="post" action="/projects/{{.Project}}/deploys/{{$run.ID}}/cancel"
        data-confirm="Cancel this deploy? Steps already applied are not rolled back."
        data-confirm-title="Cancel deploy" data-confirm-ok="Cancel deploy" data-confirm-danger="1">
    {{template "csrf" $}}
    <button type="submit" class="btn-danger">Cancel run</button>
  </form>
  {{end}}
  {{if and $run.Status.Terminal .CanDeploy}}
  <form method="post" action="/projects/{{.Project}}/deploys/{{$run.ID}}/redeploy"
        data-confirm="Redeploy {{$run.Service}} to {{$run.Env}} at {{$run.ShortSHA}}? The exact steps recorded on this run are replayed."
        data-confirm-title="Redeploy {{$run.Service}} → {{$run.Env}}" data-confirm-ok="Redeploy">
    {{template "csrf" $}}
    <button type="submit">Redeploy this commit</button>
  </form>
  {{end}}
  <a class="btn-secondary" href="/projects/{{.Project}}/deploys/{{$run.ID}}/log.txt?step={{.DeployLogStep}}"
     hx-boost="false" target="_blank" rel="noopener">Full log</a>
</div>

<div class="section">
  <h2>Steps</h2>
  {{/* No step or offset in this URL: htmx bakes a live region's hx-get at
       render time and the region element itself is never replaced (the swap is
       innerHTML), so any index baked here would be replayed unchanged forever —
       still polling step 1 after the run moved on. The endpoint follows the
       run's current step when no step is given. */}}
  <div class="live-region" id="live-deploy-run"
       hx-get="/projects/{{.Project}}/deploys/{{$run.ID}}/log"
       hx-trigger="sse:deploy"
       hx-target="this" hx-select="unset" hx-swap="innerHTML"
       hx-sync="this:queue last">
    {{template "deploy_log" .}}
  </div>
</div>
{{end}}

{{define "deploy_log"}}
{{$run := .DeployRun}}
<ol class="deploy-steps" id="deploy-step-list">
  {{range $i, $s := $run.Steps}}
  <li>
    <span class="badge {{if eq $s.Status "succeeded"}}status-done{{else if eq $s.Status "failed"}}status-error{{else if eq $s.Status "running"}}live{{else if eq $s.Status "skipped"}}status-cancelled{{else}}status-warn{{end}}">{{$s.Status}}</span>
    <span class="mono">{{$s.Name}}</span>
    {{if $s.EndedAt}}<span class="muted">· exit {{$s.ExitCode}}</span>{{end}}
    {{if $s.Error}}<span class="muted">· {{$s.Error}}</span>{{end}}
    {{if $s.LogTrunc}}<span class="flag warn" title="Middle of the output was elided">truncated</span>{{end}}
  </li>
  {{end}}
</ol>
<p class="sub">
  Status: <span class="mono">{{$run.Status}}</span>
  {{if $run.Error}} · {{$run.Error}}{{end}}
</p>
{{if .DeployLogClipped}}<p class="sub">Showing the tail only —
  <a href="/projects/{{.Project}}/deploys/{{$run.ID}}/log.txt?step={{.DeployLogStep}}"
     hx-boost="false" target="_blank" rel="noopener">full log</a>.</p>{{end}}
<pre class="mono" id="deploy-log">{{.DeployLogChunk}}</pre>
{{end}}
