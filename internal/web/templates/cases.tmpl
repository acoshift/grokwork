{{define "content"}}
<div class="pr-title-row">
  <h1 id="page-cases">{{if .Project}}{{.Project}} <span class="muted" style="font-weight:500;font-size:0.95rem">· cases</span>{{else}}Cases{{end}}</h1>
  {{if .CanOpenCase}}
  <div class="pr-head-links">
    <a class="btn btn-compact" href="/projects/{{.Project}}/cases/new">New case</a>
  </div>
  {{end}}
</div>
<p class="sub">Support cases {{if .Project}}for this project{{else}}across your projects{{end}}.</p>

{{/* Counts JSON (swap none) keeps stage chrome mounted; list still innerHTML-swaps rows. */}}
<div class="live-region"
     id="live-cases-pipeline"
     hx-get="{{route "partial.cases.counts"}}?project={{urlquery .Project}}&amp;phase={{urlquery .Cases.PhaseFilter}}&amp;severity={{urlquery .Cases.SeverityFilter}}&amp;scope={{urlquery .Cases.Scope}}&amp;owner={{urlquery .Cases.OwnerFilter}}&amp;sla={{urlquery .Cases.SLAFilter}}"
     hx-trigger="sse:cases"
     hx-target="this"
     hx-select="unset"
     hx-swap="none"
     hx-sync="this:queue last">
  {{template "cases_pipeline" .}}
</div>

<form method="get" action="{{if .Project}}/projects/{{.Project}}/cases{{else}}{{route "cases"}}{{end}}" class="toolbar" id="cases-filters">
  <div class="field">
    <label for="phase">Phase</label>
    <select id="phase" name="phase" data-autosubmit>
      <option value="" {{if eq .Cases.PhaseFilter ""}}selected{{end}}>All phases</option>
      <option value="intake" {{if eq .Cases.PhaseFilter "intake"}}selected{{end}}>Intake — new case</option>
      <option value="investigate" {{if eq .Cases.PhaseFilter "investigate"}}selected{{end}}>Investigate — looking into it</option>
      <option value="answered" {{if eq .Cases.PhaseFilter "answered"}}selected{{end}}>Answered — answer ready</option>
      <option value="fixing" {{if eq .Cases.PhaseFilter "fixing"}}selected{{end}}>Fixing — with engineering</option>
      <option value="shipping" {{if eq .Cases.PhaseFilter "shipping"}}selected{{end}}>Shipping — fix in review</option>
      <option value="closed" {{if eq .Cases.PhaseFilter "closed"}}selected{{end}}>Closed — resolved</option>
    </select>
  </div>
  <div class="field">
    <label for="severity">Severity</label>
    <select id="severity" name="severity" data-autosubmit>
      <option value="" {{if eq .Cases.SeverityFilter ""}}selected{{end}}>All severities</option>
      <option value="critical" {{if eq .Cases.SeverityFilter "critical"}}selected{{end}}>Critical</option>
      <option value="high" {{if eq .Cases.SeverityFilter "high"}}selected{{end}}>High</option>
      <option value="medium" {{if eq .Cases.SeverityFilter "medium"}}selected{{end}}>Medium</option>
      <option value="low" {{if eq .Cases.SeverityFilter "low"}}selected{{end}}>Low</option>
    </select>
  </div>
  <div class="field">
    <label for="owner">Owner</label>
    <select id="owner" name="owner" data-autosubmit>
      <option value="" {{if eq .Cases.OwnerFilter ""}}selected{{end}}>Anyone</option>
      <option value="mine" {{if eq .Cases.OwnerFilter "mine"}}selected{{end}} data-case-count="mine" data-case-count-prefix="Mine">Mine ({{.Cases.Mine}})</option>
      <option value="unassigned" {{if eq .Cases.OwnerFilter "unassigned"}}selected{{end}} data-case-count="unassigned" data-case-count-prefix="Needs an engineer">Needs an engineer ({{.Cases.Unassigned}})</option>
    </select>
  </div>
  <div class="field">
    <label for="sla">SLA</label>
    <select id="sla" name="sla" data-autosubmit>
      <option value="" {{if eq .Cases.SLAFilter ""}}selected{{end}}>Any</option>
      <option value="breached" {{if eq .Cases.SLAFilter "breached"}}selected{{end}} data-case-count="breached" data-case-count-prefix="Breached">Breached ({{.Cases.Breached}})</option>
    </select>
  </div>
  <div class="field">
    <label for="scope">Show</label>
    <select id="scope" name="scope" data-autosubmit>
      <option value="open" {{if eq .Cases.Scope "open"}}selected{{end}}>Open cases (default)</option>
      <option value="all" {{if eq .Cases.Scope "all"}}selected{{end}}>All incl. closed</option>
    </select>
  </div>
  <button type="submit" class="btn-secondary">Apply</button>
</form>

<div class="live-region"
     id="live-cases-list"
     hx-get="{{route "partial.cases.list"}}?project={{urlquery .Project}}&amp;phase={{urlquery .Cases.PhaseFilter}}&amp;severity={{urlquery .Cases.SeverityFilter}}&amp;scope={{urlquery .Cases.Scope}}&amp;owner={{urlquery .Cases.OwnerFilter}}&amp;sla={{urlquery .Cases.SLAFilter}}"
     hx-trigger="sse:cases"
     hx-target="this"
     hx-select="unset"
     hx-swap="innerHTML"
     hx-sync="this:queue last">
  {{template "cases_list" .}}
</div>
<script>
(function () {
  function paint(data) {
    if (!data || typeof data !== "object") return;
    document.querySelectorAll("[data-case-count]").forEach(function (el) {
      var key = el.getAttribute("data-case-count");
      if (!key || !Object.prototype.hasOwnProperty.call(data, key)) return;
      var n = data[key];
      if (typeof n !== "number" || !isFinite(n)) return;
      n = Math.floor(n);
      var prefix = el.getAttribute("data-case-count-prefix");
      if (prefix) {
        el.textContent = prefix + " (" + n + ")";
        return;
      }
      el.textContent = String(n);
      var stage = el.closest(".case-stage");
      if (stage) stage.classList.toggle("is-zero", n === 0);
    });
  }
  function paintFromEvent(e) {
    var d = e && e.detail;
    if (!d || !d.xhr) return;
    if (d.successful === false) return;
    var url = "";
    if (d.pathInfo) url = d.pathInfo.requestPath || d.pathInfo.finalRequestPath || "";
    if (!url && d.xhr.responseURL) url = d.xhr.responseURL;
    if (url.indexOf("/partials/cases/counts") === -1) return;
    try { paint(JSON.parse(d.xhr.responseText)); } catch (err) {}
  }
  function load() {
    var host = document.getElementById("live-cases-pipeline");
    if (!host) return;
    var url = host.getAttribute("hx-get");
    if (!url) return;
    fetch(url, {
      credentials: "same-origin",
      cache: "no-store",
      headers: { Accept: "application/json" }
    }).then(function (r) {
      return r.ok ? r.json() : null;
    }).then(paint).catch(function () {});
  }
  if (!window.__gwCaseCountsBound) {
    window.__gwCaseCountsBound = true;
    document.body.addEventListener("htmx:afterOnLoad", paintFromEvent);
    document.body.addEventListener("htmx:afterRequest", paintFromEvent);
  }
  load();
})();
</script>
{{end}}

{{/* cases_qs carries the non-phase filters onto the pipeline stage links, so
     clicking a stage narrows the board instead of resetting the other filters.
     Called with .Cases. The &amp; stay literal text — building the suffix in a
     variable would put it through the URL escaper and percent-encode them. */}}
{{define "cases_qs"}}
{{- if .SeverityFilter}}&amp;severity={{urlquery .SeverityFilter}}{{end}}
{{- if .OwnerFilter}}&amp;owner={{urlquery .OwnerFilter}}{{end}}
{{- if .SLAFilter}}&amp;sla={{urlquery .SLAFilter}}{{end}}
{{- end}}

{{define "cases_pipeline"}}
{{$base := route "cases"}}{{if .Project}}{{$base = print "/projects/" .Project "/cases"}}{{end}}
<div class="case-pipeline" id="case-pipeline">
  <div class="case-rail">
    <a class="case-stage{{if eq .Cases.PhaseFilter "intake"}} active{{end}}{{if eq .Cases.Intake 0}} is-zero{{end}}"
       href="{{$base}}?phase=intake{{template "cases_qs" .Cases}}">
      <span class="stage-name">intake</span>
      <span class="stage-count" data-case-count="intake">{{.Cases.Intake}}</span>
      <span class="stage-plain">New case</span>
    </a>
    <a class="case-stage{{if eq .Cases.PhaseFilter "investigate"}} active{{end}}{{if eq .Cases.Investigate 0}} is-zero{{end}}"
       href="{{$base}}?phase=investigate{{template "cases_qs" .Cases}}">
      <span class="stage-name">investigate</span>
      <span class="stage-count" data-case-count="investigate">{{.Cases.Investigate}}</span>
      <span class="stage-plain">Looking into it</span>
    </a>
    <a class="case-stage{{if eq .Cases.PhaseFilter "answered"}} active{{end}}{{if eq .Cases.Answered 0}} is-zero{{end}}"
       href="{{$base}}?phase=answered{{template "cases_qs" .Cases}}">
      <span class="stage-name">answered</span>
      <span class="stage-count" data-case-count="answered">{{.Cases.Answered}}</span>
      <span class="stage-plain">Answer ready</span>
    </a>
    <a class="case-stage{{if eq .Cases.PhaseFilter "fixing"}} active{{end}}{{if eq .Cases.Fixing 0}} is-zero{{end}}"
       href="{{$base}}?phase=fixing{{template "cases_qs" .Cases}}">
      <span class="stage-name">fixing</span>
      <span class="stage-count" data-case-count="fixing">{{.Cases.Fixing}}</span>
      <span class="stage-plain">With engineering</span>
    </a>
    <a class="case-stage{{if eq .Cases.PhaseFilter "shipping"}} active{{end}}{{if eq .Cases.Shipping 0}} is-zero{{end}}"
       href="{{$base}}?phase=shipping{{template "cases_qs" .Cases}}">
      <span class="stage-name">shipping</span>
      <span class="stage-count" data-case-count="shipping">{{.Cases.Shipping}}</span>
      <span class="stage-plain">Fix in review</span>
    </a>
  </div>
  <a class="case-archive{{if eq .Cases.PhaseFilter "closed"}} active{{end}}"
     href="{{$base}}?phase=closed{{template "cases_qs" .Cases}}">
    <span class="stage-name">closed</span>
    <span class="stage-count" data-case-count="closed">{{.Cases.Closed}}</span>
    <span class="stage-plain">Resolved</span>
  </a>
</div>
{{end}}

{{define "cases_list"}}
<div class="section" id="cases-list">
  {{if .Cases.Groups}}
  {{range .Cases.Groups}}
  <section class="case-lane" id="lane-{{.Phase}}">
    <header class="case-lane-head">
      <h2>{{.Phase}}</h2>
      <span class="lane-plain">{{.Plain}}</span>
      <span class="lane-count mono">{{len .Rows}}</span>
    </header>
    <div class="case-rows">
      {{range .Rows}}
      <article class="case-row{{if .Severity}} sev-{{.Severity}}{{end}}">
        <div class="case-main">
          {{/* back= stamps this board (filters included) as the detail page's
               ← crumb target. $.CasesBoardURL, not the row's project: the
               global board must return to the global board. */}}
          <a class="case-title" href="/sessions/{{.ThreadID}}?project={{urlquery .Project}}&amp;back={{urlquery $.CasesBoardURL}}">{{.Title}}</a>
          <div class="case-meta">
            {{/* Our id first, then theirs: CaseKey is what another case, a
                 commit or a PR quotes; CustomerRef is the ticket it came from. */}}
            {{if .CaseKey}}<span class="mono case-key">{{.CaseKey}}</span>{{end}}
            {{if not $.Project}}<a class="case-proj" href="/projects/{{.Project}}/cases">{{.Project}}</a>{{end}}
            {{if .CustomerRef}}<span class="mono case-ref">{{.CustomerRef}}</span>{{end}}
            {{if .Severity}}<span class="case-sev sev-{{.Severity}}">{{.Severity}}</span>{{end}}
            {{/* The thread snowflake is the storage key, not a name anyone
                 uses. Keep it only for cases filed before keys existed, where
                 it is still the sole way to refer to the row. */}}
            {{if not .CaseKey}}<span class="mono muted">{{.ThreadID}}</span>{{end}}
            {{if .EngineerName}}<span>eng {{.EngineerName}}</span>{{else if .NeedsEngineer}}<span class="case-unassigned">needs an engineer</span>{{end}}
            {{if .OwnerName}}<span>owner {{.OwnerName}}</span>{{end}}
            {{if .ReporterName}}<span>reporter {{.ReporterName}}</span>{{end}}
            {{if .Origin}}<span class="muted">via {{.Origin}}</span>{{end}}
            <span class="muted">{{shortTime .UpdatedAt}}</span>
            {{if .DiscordURL}}<a href="{{.DiscordURL}}" target="_blank" rel="noopener">Discord ↗</a>{{end}}
          </div>
          {{if .CustomerUpdate}}
          <p class="case-update clamp"><span class="case-update-tag">customer update</span>{{.CustomerUpdate}}</p>
          {{else if .DossierSummary}}
          <p class="case-update clamp"><span class="case-update-tag">dossier</span>{{.DossierSummary}}</p>
          {{end}}
        </div>
        <div class="case-side">
          {{/* Computed at render time, so it is current for this page rather
               than for whenever the case was last written (bot.CaseSLAFor). */}}
          {{if .SLABadge}}<span class="badge{{if .SLABreached}} status-error{{else if .SLAHeld}} status-warn{{end}}" title="{{.SLADetail}}">{{.SLABadge}}</span>{{end}}
          {{if .Running}}<span class="badge live">running</span>{{end}}
          {{if gt .Queue 0}}<span class="badge">queue {{.Queue}}</span>{{end}}
          {{if .Resolution}}
            {{if or (eq .Resolution "answered") (eq .Resolution "fixed")}}
            <span class="badge status-done">{{.Resolution}}</span>
            {{else if eq .Resolution "escalated_external"}}
            <span class="badge status-warn">escalated</span>
            {{else}}
            <span class="badge status-cancelled">{{.Resolution}}</span>
            {{end}}
          {{end}}
          {{if .PRNumber}}
            {{if and .GHOwner .GHRepo}}
            <a class="badge{{if .PRChecksFailing}} status-error{{else if eq .PRState "MERGED"}} status-merged{{else if eq .PRState "CLOSED"}} status-cancelled{{else}} live{{end}}"
               href="/prs/{{.GHOwner}}/{{.GHRepo}}/{{.PRNumber}}?project={{urlquery .Project}}">PR #{{.PRNumber}} · {{if .PRChecksFailing}}CI failing{{else}}{{.PRState}}{{end}}</a>
            {{else}}
            <span class="badge">PR #{{.PRNumber}} · {{.PRState}}</span>
            {{end}}
          {{end}}
        </div>
      </article>
      {{end}}
    </div>
  </section>
  {{end}}
  {{else}}
  <div class="empty" id="cases-empty">
    {{if eq .Cases.Total 0}}
    {{if .Project}}
    <p style="margin:0">No support cases in <span class="mono">{{.Project}}</span> yet.{{if .CanOpenCase}} Open one here, or with <span class="mono">@Grok /case &lt;title&gt;</span> in a mapped Discord channel.{{end}}</p>
    {{if .CanOpenCase}}<p style="margin:0.65rem 0 0"><a class="btn btn-compact" href="/projects/{{.Project}}/cases/new">New case</a></p>{{end}}
    {{else}}
    <p style="margin:0">No support cases in your projects yet. Open one from a project&rsquo;s case board, or with <span class="mono">@Grok /case &lt;title&gt;</span> in a mapped Discord channel.</p>
    {{end}}
    {{else}}
    No cases match this filter ({{.Cases.Total}} tracked, {{.Cases.OpenTotal}} open).
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
