{{define "content"}}
<div id="page-project-config-integrations">
{{template "project_config_header" $}}

<div class="section card" id="project-discord">
  <h2>Discord</h2>
  <p class="sub" style="margin-top:0">
    Tagging <span class="mono">@Grok</span> in a mapped channel starts tasks for this project.
    The preferred channel hosts threads for web-started work units.
  </p>
  {{if .ProjectItem.ChannelOptions}}
  <div class="chip-row">
    {{$pref := .ProjectItem.DiscordChannelID}}
    {{range .ProjectItem.ChannelOptions}}
    <span class="chip">{{.}}{{if eq . $pref}}<span class="pref">preferred</span>{{end}}
      <form method="post" action="{{route "config.removeChannel"}}" data-confirm="Unmap channel {{.}}?" data-confirm-title="Unmap channel" data-confirm-ok="Unmap" data-confirm-danger>
        {{template "csrf" $}}
        <input type="hidden" name="channelId" value="{{.}}">
        <input type="hidden" name="project" value="{{$.ProjectItem.Name}}">
        <input type="hidden" name="return_to" value="project">
        <button type="submit" title="Unmap channel">×</button>
      </form>
    </span>
    {{end}}
  </div>
  {{else}}
  <div class="empty" style="margin-bottom:0.85rem;">No channels mapped — <span class="mono">@Grok</span> can’t start tasks here yet. Work can still start from the web UI.</div>
  {{end}}
  <form class="inline" method="post" action="{{route "config.addChannel"}}" style="grid-template-columns: 1fr auto;">
    {{template "csrf" $}}
    <input type="hidden" name="project" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="return_to" value="project">
    <div>
      <label for="project-add-channel">Discord channel ID</label>
      <input id="project-add-channel" type="text" name="channelId" placeholder="123456789012345678" required autocomplete="off">
    </div>
    <button type="submit">Map channel</button>
  </form>

  <div style="border-top:1px solid var(--border); margin-top:1.1rem; padding-top:1rem;">
    <form class="inline" method="post" action="{{route "config.setProjectChannel"}}" style="grid-template-columns: 1fr 1fr auto;">
      {{template "csrf" $}}
      <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
      <div>
        <label for="project-channel">Preferred channel</label>
        <select id="project-channel" name="channelId">
          <option value="">(auto)</option>
          {{$pref := .ProjectItem.DiscordChannelID}}
          {{range .ProjectItem.ChannelOptions}}
          <option value="{{.}}" {{if eq . $pref}}selected{{end}}>{{.}}</option>
          {{end}}
        </select>
      </div>
      <div>
        <label for="project-guild">Discord guild ID</label>
        <input id="project-guild" type="text" name="guildId" value="{{.ProjectItem.DiscordGuildID}}" placeholder="server snowflake" autocomplete="off">
      </div>
      <button type="submit">Save Discord</button>
    </form>
    <p class="sub" style="margin:0.5rem 0 0">
      The guild ID makes “Open in Discord” deep-link the right server (multi-guild setups).
      Empty falls back to the default guild on <a href="{{route "config"}}#default-guild">Config</a>.
    </p>
  </div>
</div>

<div class="section card" id="project-github">
  <h2>GitHub repositories</h2>
  <p class="sub" style="margin-top:0">
    Multi-repo catalog for issues, commits, and PR tracking — one <span class="mono">owner/repo</span> per line.
    Leave blank to discover from the checkout’s git remotes.
  </p>
  <form method="post" action="{{route "config.setProjectGitHub"}}">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <label for="project-repos">Repos</label>
    <textarea id="project-repos" name="repos" rows="4" placeholder="acme/app&#10;acme/api">{{.ProjectItem.GitHubReposText}}</textarea>
    <div class="form-actions"><button type="submit">Save repos</button></div>
  </form>
</div>

<div class="section card" id="project-linear">
  <h2>Linear</h2>
  <p class="sub" style="margin-top:0">
    Opt-in ticket binding for this project.
    {{if .ProjectItem.LinearAPIKeySet}}<span class="badge status-done">API key set</span>{{else}}<span class="badge">no API key</span>{{end}}
    · env alternative: <span class="mono">{{.ProjectItem.LinearEnvHint}}</span>
  </p>
  <form method="post" action="{{route "config.setProjectLinear"}}">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <div class="inline" style="grid-template-columns: auto 1fr 1fr; margin-bottom:0.65rem;">
      <label class="check">
        <input type="checkbox" name="enabled" value="1" {{if .ProjectItem.LinearEnabled}}checked{{end}}>
        Enabled
      </label>
      <div>
        <label for="project-linear-team">Team key</label>
        <input id="project-linear-team" type="text" name="teamKey" value="{{.ProjectItem.LinearTeamKey}}" placeholder="ENG" autocomplete="off">
      </div>
      <div>
        <label for="project-linear-key">API key</label>
        <input id="project-linear-key" type="password" name="apiKey" placeholder="leave blank to keep" autocomplete="off">
      </div>
    </div>
    <label class="check">
      <input type="checkbox" name="clearApiKey" value="1"> Clear stored API key
    </label>
    <div class="form-actions"><button type="submit">Save Linear</button></div>
  </form>
</div>

<div class="section card" id="project-clickup">
  <h2>ClickUp</h2>
  <p class="sub" style="margin-top:0">
    Opt-in ticket binding for this project.
    {{if .ProjectItem.ClickUpAPIKeySet}}<span class="badge status-done">API key set</span>{{else}}<span class="badge">no API key</span>{{end}}
    · env alternative: <span class="mono">{{.ProjectItem.ClickUpEnvHint}}</span>
  </p>
  <form method="post" action="{{route "config.setProjectClickUp"}}">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <div class="inline" style="grid-template-columns: auto 1fr 1fr; margin-bottom:0.65rem;">
      <label class="check">
        <input type="checkbox" name="enabled" value="1" {{if .ProjectItem.ClickUpEnabled}}checked{{end}}>
        Enabled
      </label>
      <div>
        <label for="project-clickup-ws">Workspace ID</label>
        <input id="project-clickup-ws" type="text" name="workspaceId" value="{{.ProjectItem.ClickUpWorkspaceID}}" placeholder="1234567" autocomplete="off">
      </div>
      <div>
        <label for="project-clickup-list">List ID</label>
        <input id="project-clickup-list" type="text" name="listId" value="{{.ProjectItem.ClickUpListID}}" placeholder="15505202" autocomplete="off">
      </div>
    </div>
    <div class="inline" style="grid-template-columns: 1fr 1fr; margin-bottom:0.65rem;">
      <div>
        <label for="project-clickup-prefix">Custom ID prefix</label>
        <input id="project-clickup-prefix" type="text" name="customIdPrefix" value="{{.ProjectItem.ClickUpCustomIdPrefix}}" placeholder="DEV" autocomplete="off">
      </div>
      <div>
        <label for="project-clickup-key">API key</label>
        <input id="project-clickup-key" type="password" name="apiKey" placeholder="leave blank to keep" autocomplete="off">
      </div>
    </div>
    <label class="check">
      <input type="checkbox" name="clearApiKey" value="1"> Clear stored API key
    </label>
    <div class="form-actions"><button type="submit">Save ClickUp</button></div>
  </form>
</div>


<div class="section card" id="project-actions">
  <h2>GitHub Actions</h2>
  <p class="sub" style="margin-top:0">
    Branch locks for <span class="mono">workflow_dispatch</span>: when a rule matches a workflow file,
    the Actions page only offers those branches and the server enforces the same list.
    Workflow is the file name (e.g. <span class="mono">deploy.yml</span>); optional repo scopes a multi-repo project.
  </p>
  {{if .ProjectItem.ActionsRules}}
  <div class="table-scroll" style="margin-bottom:0.85rem">
  <table>
    <thead><tr><th>Workflow</th><th>Branches</th><th>Repo</th><th></th></tr></thead>
    <tbody>
    {{range .ProjectItem.ActionsRules}}
      <tr>
        <td class="mono">{{.Workflow}}</td>
        <td class="mono">{{range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b}}{{end}}</td>
        <td class="mono muted">{{if .Repo}}{{.Repo}}{{else}}any{{end}}</td>
        <td>
          <form method="post" action="{{route "config.removeProjectActionsRule"}}"
                data-confirm="Remove branch lock for {{.Workflow}}?"
                data-confirm-title="Remove Actions rule" data-confirm-ok="Remove" data-confirm-danger>
            {{template "csrf" $}}
            <input type="hidden" name="name" value="{{$.ProjectItem.Name}}">
            <input type="hidden" name="workflow" value="{{.Workflow}}">
            <input type="hidden" name="repo" value="{{.Repo}}">
            <button type="submit" class="btn-danger">Remove</button>
          </form>
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  {{else}}
  <div class="empty" style="margin-bottom:0.85rem">No branch locks — every dispatchable workflow may run on any branch.</div>
  {{end}}
  <form method="post" action="{{route "config.setProjectActionsRule"}}">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <div class="inline" style="grid-template-columns: 1fr 1fr 1fr auto; align-items:end">
      <div>
        <label for="actions-rule-workflow">Workflow file</label>
        <input id="actions-rule-workflow" type="text" name="workflow" placeholder="deploy.yml" required class="mono" autocomplete="off">
      </div>
      <div>
        <label for="actions-rule-branches">Branches (comma-separated)</label>
        <input id="actions-rule-branches" type="text" name="branches" placeholder="production, release" required class="mono" autocomplete="off">
      </div>
      <div>
        <label for="actions-rule-repo">Repo (optional)</label>
        <input id="actions-rule-repo" type="text" name="repo" placeholder="owner/name or name" class="mono" autocomplete="off">
      </div>
      <button type="submit">Add rule</button>
    </div>
  </form>
</div>

<div class="section card" id="project-storage">
  <h2>File storage</h2>
  <p class="sub" style="margin-top:0">
    The project’s <a href="/projects/{{.ProjectItem.Name}}/files">Files</a> page uses an override when set,
    otherwise the <a href="{{route "config.storage"}}">global default</a> under an isolated path
    (GCS prefix or Drive child folder). An override replaces the global backend and identity;
    leave credentials empty to keep using the global key. Switching backend on save strips the other backend’s identity.
  </p>

  {{$pBackend := .ProjectItem.StorageBackend}}
  {{if not $pBackend}}{{$pBackend = "gcs"}}{{end}}
  {{$effBackend := .ProjectItem.StorageEffectiveBackend}}

  {{if eq .ProjectItem.StorageSource "disabled"}}
  <p class="sub"><span class="badge status-warn">disabled</span> Files page is off for this project.</p>
  <form method="post" action="{{route "config.setProjectStorage"}}" style="display:inline">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="action" value="clear">
    {{if .Config.StorageConfigured}}
    <button type="submit" data-confirm="Re-enable inheritance from the global default under an isolated path?"
      data-confirm-title="Re-enable storage" data-confirm-ok="Re-enable">Re-enable inheritance</button>
    {{else}}
    <button type="submit">Clear disable</button>
    {{end}}
  </form>
  {{else if eq .ProjectItem.StorageSource "global"}}
  <p class="sub" style="margin-top:0">
    <span class="badge">from global default</span>
    {{if eq $effBackend "gdrive"}}
    Effective: Drive · folder <span class="mono">{{.ProjectItem.StorageEffectiveDriveFolderID}}</span>
    {{if .ProjectItem.StorageEffectiveIsolation}}· isolation <span class="mono">{{.ProjectItem.StorageEffectiveIsolation}}</span>{{end}}
    {{else}}
    Effective: bucket <span class="mono">{{.ProjectItem.StorageEffectiveBucket}}</span>
    {{if .ProjectItem.StorageEffectivePrefix}}· prefix <span class="mono">{{.ProjectItem.StorageEffectivePrefix}}</span>{{end}}
    {{end}}
  </p>
  <form method="post" action="{{route "config.setProjectStorage"}}" style="display:inline;margin-right:0.5rem"
        data-confirm="Turn Files off for this project even if a global default is set?"
        data-confirm-title="Disable storage" data-confirm-ok="Disable" data-confirm-danger>
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="action" value="disable">
    <button type="submit" class="btn-danger">Disable for this project</button>
  </form>
  {{else if eq .ProjectItem.StorageSource "override"}}
  <p class="sub" style="margin-top:0">
    <span class="badge">override</span>
    {{if eq $pBackend "gdrive"}}Custom Drive folder for this project.{{else}}Custom bucket for this project.{{end}}
  </p>
  {{else}}
  <p class="sub" style="margin-top:0">No storage linked. Set a project override below{{if .Config.StorageConfigured}}, or it will inherit the global default once configured{{end}}.</p>
  {{end}}

  {{if ne .ProjectItem.StorageSource "disabled"}}
  <form method="post" action="{{route "config.setProjectStorage"}}" style="margin-top:0.85rem" id="project-storage-save" data-storage-form>
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="action" value="save">
    <div>
      <label for="project-storage-backend">Backend</label>
      <select id="project-storage-backend" name="backend" data-storage-backend-select>
        <option value="gcs" {{if ne $pBackend "gdrive"}}selected{{end}}>Google Cloud Storage</option>
        <option value="gdrive" {{if eq $pBackend "gdrive"}}selected{{end}}>Google Drive</option>
      </select>
    </div>
    <div data-backend-fields="gcs" {{if eq $pBackend "gdrive"}}hidden{{end}} style="margin-top:0.65rem">
      <div class="inline" style="grid-template-columns: 1fr 1fr; align-items:end">
        <div>
          <label for="project-storage-bucket">GCS bucket</label>
          <input id="project-storage-bucket" type="text" name="gcsBucket" value="{{.ProjectItem.StorageBucket}}"
            placeholder="acme-app-files" class="mono" autocomplete="off">
        </div>
        <div>
          <label for="project-storage-prefix">Prefix (optional)</label>
          <input id="project-storage-prefix" type="text" name="prefix" value="{{.ProjectItem.StoragePrefix}}"
            placeholder="grokwork" class="mono" autocomplete="off">
        </div>
      </div>
      <p class="sub" style="margin:0.35rem 0 0">If you reuse the company bucket, set a unique prefix (e.g. <span class="mono">grokwork/{{.ProjectItem.Name}}</span>) so this project does not share another project’s objects. The project name is <strong>not</strong> appended to an override prefix.</p>
    </div>
    <div data-backend-fields="gdrive" {{if ne $pBackend "gdrive"}}hidden{{end}} style="margin-top:0.65rem">
      <div>
        <label for="project-storage-folder">Drive folder ID or URL</label>
        <input id="project-storage-folder" type="text" name="driveFolderId" value="{{.ProjectItem.StorageDriveFolderID}}"
          placeholder="0ABcdEfghIjKlMnOp" class="mono" autocomplete="off">
      </div>
      <p class="sub" style="margin:0.35rem 0 0">Override uses this folder as-is (no isolation segment). Prefer a dedicated folder, not the global root.</p>
    </div>
    <div style="margin-top:0.65rem">
      <label for="project-storage-credentials">Credentials file <span data-backend-cred-label>(optional)</span></label>
      <input id="project-storage-credentials" type="text" name="credentialsFile" value="{{.ProjectItem.StorageCredentialsFile}}"
        placeholder="/etc/grokwork/sa-key.json" class="mono" autocomplete="off">
      <p class="sub" style="margin:0.35rem 0 0" data-backend-cred-help>
        Absolute path on the host to a service-account JSON key. Empty uses the global file-storage credentials. GCS with no key at either layer uses host <span class="mono">gcloud</span> login/ADC.
      </p>
    </div>
    <button type="submit" style="margin-top:0.65rem">{{if eq .ProjectItem.StorageSource "override"}}Save override{{else}}Link storage{{end}}</button>
  </form>
  {{if eq .ProjectItem.StorageSource "override"}}
  <form method="post" action="{{route "config.setProjectStorage"}}" style="margin-top:0.65rem"
    {{if .Config.StorageConfigured}}
        data-confirm="Clear this override and re-inherit the global default under an isolated path?"
        data-confirm-title="Clear override" data-confirm-ok="Clear override"
    {{else}}
        data-confirm="Unlink storage for this project? The Files page will turn off."
        data-confirm-title="Unlink storage" data-confirm-ok="Unlink" data-confirm-danger
    {{end}}>
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="action" value="clear">
    <button type="submit" class="btn-secondary">{{if .Config.StorageConfigured}}Clear override (use global){{else}}Unlink storage{{end}}</button>
  </form>
  {{end}}
  {{else}}
  <form method="post" action="{{route "config.setProjectStorage"}}" style="margin-top:0.85rem" data-storage-form>
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <input type="hidden" name="action" value="save">
    <div>
      <label for="project-storage-backend-disabled">Backend</label>
      <select id="project-storage-backend-disabled" name="backend" data-storage-backend-select>
        <option value="gcs" selected>Google Cloud Storage</option>
        <option value="gdrive">Google Drive</option>
      </select>
    </div>
    <div data-backend-fields="gcs" style="margin-top:0.65rem">
      <div class="inline" style="grid-template-columns: 1fr 1fr; align-items:end">
        <div>
          <label for="project-storage-bucket-disabled">GCS bucket</label>
          <input id="project-storage-bucket-disabled" type="text" name="gcsBucket" placeholder="acme-app-files" class="mono" autocomplete="off">
        </div>
        <div>
          <label for="project-storage-prefix-disabled">Prefix (optional)</label>
          <input id="project-storage-prefix-disabled" type="text" name="prefix" placeholder="grokwork" class="mono" autocomplete="off">
        </div>
      </div>
    </div>
    <div data-backend-fields="gdrive" hidden style="margin-top:0.65rem">
      <div>
        <label for="project-storage-folder-disabled">Drive folder ID or URL</label>
        <input id="project-storage-folder-disabled" type="text" name="driveFolderId" placeholder="0ABcdEfghIjKlMnOp" class="mono" autocomplete="off">
      </div>
    </div>
    <div style="margin-top:0.65rem">
      <label for="project-storage-credentials-disabled">Credentials file <span data-backend-cred-label>(optional)</span></label>
      <input id="project-storage-credentials-disabled" type="text" name="credentialsFile" placeholder="/etc/grokwork/sa-key.json" class="mono" autocomplete="off">
      <p class="sub" style="margin:0.35rem 0 0" data-backend-cred-help>Absolute path on the host to a service-account JSON key. Empty uses the global file-storage credentials.</p>
    </div>
    <button type="submit" style="margin-top:0.65rem">Set custom storage…</button>
  </form>
  {{end}}
</div>
<script>
(function () {
  document.querySelectorAll('[data-storage-form]').forEach(function (form) {
    var sel = form.querySelector('[data-storage-backend-select]');
    if (!sel) return;
    function sync() {
      var v = sel.value === 'gdrive' ? 'gdrive' : 'gcs';
      form.querySelectorAll('[data-backend-fields]').forEach(function (el) {
        el.hidden = el.getAttribute('data-backend-fields') !== v;
      });
    }
    sel.addEventListener('change', sync);
    sync();
  });
})();
</script>


<div class="section card" id="project-repo-fetch">
  <h2>Repo freshness</h2>
  <p class="sub" style="margin-top:0">
    While Grok Work is running, periodically run <span class="mono">git fetch --all --prune</span> on this project’s
    main checkout so commits / remote-tracking refs stay fresh.
    Default is <span class="mono">5</span> minutes when unset; <span class="mono">0</span> disables idle fetch.
    New worktrees always fetch first, independent of this setting.
  </p>
  <form class="inline" method="post" action="{{route "config.setProjectFetch"}}" style="grid-template-columns: 12rem auto;">
    {{template "csrf" $}}
    <input type="hidden" name="name" value="{{.ProjectItem.Name}}">
    <div>
      <label for="project-fetch-interval">Idle interval (minutes)</label>
      <input id="project-fetch-interval" type="number" name="repoFetchIntervalMinutes" min="0" step="1" required
        value="{{.ProjectItem.RepoFetchIntervalMinutes}}" autocomplete="off">
    </div>
    <div class="form-actions" style="align-self:end"><button type="submit">Save</button></div>
  </form>
</div>
</div>
{{end}}
