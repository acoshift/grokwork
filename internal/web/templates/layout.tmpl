          input.select();
        }
        if (status) status.textContent = "Select and copy manually";
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(ok).catch(fail);
      } else {
        fail();
      }
    });

    // iOS-family WebKit (Safari, home-screen PWAs, every iOS browser skin —
    // all WKWebView; iPadOS reports a "Macintosh" UA but multi-touch). Its
    // native <select> pickers stay on screen while change fires — the wheel
    // picker emits one per detent. Read navigator per call, not once at init,
    // so tests can shadow the properties.
    function iosNativePicker() {
      return /iPhone|iPad|iPod/.test(navigator.userAgent) ||
        (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.platform));
    }

    function autoSubmitForm(form) {
      if (form.requestSubmit) form.requestSubmit();
      else form.submit();
    }

    // Hold a select's autosubmit until its native picker dismisses. Submitting
    // mid-change would boost-swap #live-root and tear the open picker off the
    // control (page visibly "reloads" under the open dropdown). Dismissal
    // blurs the control; a document-level pointerdown is the fallback for
    // picker styles that keep focus after closing — while the picker is up,
    // touches land on the native overlay and never reach the document.
    // Repeat changes (wheel scrolling) collapse into one submit of the final
    // value.
    function deferAutoSubmit(el) {
      if (el.__gwAutoSubmitArmed) return;
      el.__gwAutoSubmitArmed = true;
      function flush() {
        el.removeEventListener("blur", flush);
        document.removeEventListener("pointerdown", onDoc, true);
        el.__gwAutoSubmitArmed = false;
        if (el.isConnected && el.form) autoSubmitForm(el.form);
      }
      function onDoc(ev) {
        // Tapping the select itself re-opens its picker — keep holding.
        if (ev.target === el) return;
        flush();
      }
      el.addEventListener("blur", flush);
      document.addEventListener("pointerdown", onDoc, true);
    }

    document.addEventListener("change", function (e) {
      if (e.target && e.target.id === "risky-use-default") {
        var ta = document.getElementById("risky-globs");
        if (ta) ta.readOnly = e.target.checked;
      }
      // Selects, radios, and checkboxes (config hub switches) marked
      // data-autosubmit apply on change (boosted POST/GET keeps the SPA
      // feel).
      var el = e.target;
      if (el && el.matches &&
          el.matches("select[data-autosubmit], input[type=radio][data-autosubmit], input[type=checkbox][data-autosubmit]") && el.form) {
        if (el.tagName === "SELECT" && document.activeElement === el && iosNativePicker()) {
          deferAutoSubmit(el);
        } else {
          autoSubmitForm(el.form);
        }
      }
    });

    // ← / → page through any on-page pager (commits list). Skipped while
    // typing so text-field caret movement is untouched.
    document.addEventListener("keydown", function (e) {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      var t = e.target;
      if (t instanceof Element && (t.matches("input, textarea, select") || t.isContentEditable)) return;
      var sel = e.key === "ArrowLeft" ? "a[data-pager-prev]" : "a[data-pager-next]";
      var link = document.querySelector(".pager " + sel);
      if (link) { e.preventDefault(); link.click(); }
    });

    // Pause domain partial swaps only when they would clobber in-region focus
    // or a confirm modal. Focus outside the region (composer, filters, rails)
    // must keep live updates flowing.
    document.body.addEventListener("htmx:beforeRequest", function (e) {
      var elt = e.detail && e.detail.elt;
      if (!elt || !elt.classList || !elt.classList.contains("live-region")) return;
      // A swap while the confirm modal is open detaches the form behind it, and
      // the confirm handler then bails on !form.isConnected, losing the click
      // silently. isEditingInside does not cover this: focus is on a dialog
      // button, not an INPUT. Belt and braces — trigger forms also live outside
      // live regions, so the common case never reaches here.
      var confirmDlg = document.getElementById("gw-confirm-modal");
      if (confirmDlg && confirmDlg.open) {
        e.preventDefault();
        setStatus("live · paused while confirming", "warn");
        return;
      }
      if (isEditingInside(elt)) {
        e.preventDefault();
        setStatus("live · paused while editing", "warn");
      }
    });

    // Page-change progress bar: boosted navigations only, so SSE region
    // refreshes stay silent. The 120ms delay keeps instant swaps flash-free.
    var loader = document.getElementById("page-loader");
    var loaderTimer = null;
    function loaderStart() {
      if (!loader) return;
      clearTimeout(loaderTimer);
      loaderTimer = setTimeout(function () { loader.classList.add("on"); }, 120);
    }
    function loaderStop() {
      if (!loader) return;
      clearTimeout(loaderTimer);
      loaderTimer = null;
      if (!loader.classList.contains("on")) return;
      loader.classList.add("done");
      setTimeout(function () { loader.classList.remove("on", "done"); }, 300);
    }

    // Submit buttons in flight: disable so a double click cannot POST twice
    // (queue two Grok runs, add a project twice, …), spinner via .is-loading.
    // Only buttons this code disabled are re-enabled — template-disabled ones
    // (busy prune, TTL off) stay disabled.
    function setFormLoading(form, on) {
      if (!form || !form.querySelectorAll) return;
      form.querySelectorAll('button[type="submit"], button:not([type])').forEach(function (b) {
        if (on) {
          if (b.disabled) return;
          b.disabled = true;
          b.dataset.wasEnabled = "1";
          b.classList.add("is-loading");
        } else if (b.dataset.wasEnabled) {
          b.disabled = false;
          delete b.dataset.wasEnabled;
          b.classList.remove("is-loading");
        }
      });
    }

    // beforeRequest fires synchronously while the request is issued, so the
    // disable lands before any second click can be processed.
    document.body.addEventListener("htmx:beforeRequest", function (e) {
      var d = e.detail || {};
      if (d.boosted) loaderStart();
      if (d.elt && d.elt.tagName === "FORM") setFormLoading(d.elt, true);
    });
    // afterRequest also fires on errors; if the swap replaced the form this is
    // a no-op on the detached node and the fresh DOM arrives enabled.
    document.body.addEventListener("htmx:afterRequest", function (e) {
      var d = e.detail || {};
      if (d.elt && d.elt.tagName === "FORM") setFormLoading(d.elt, false);
    });
    ["htmx:responseError", "htmx:sendError", "htmx:sendAbort", "htmx:timeout"].forEach(function (ev) {
      document.body.addEventListener(ev, function () { loaderStop(); });
    });

    // Non-htmx submissions (hx-boost="false": logout, commit review) unload
    // the page natively; disable on the next tick so the submit itself is
    // unaffected. Boosted forms are skipped here (htmx preventDefaults them
    // and the htmx listeners above handle their lifecycle). Unconfirmed
    // data-confirm submits never reach this listener — the confirm-modal
    // capture handler stops their propagation. method="dialog" submits
    // (the confirm modal's own buttons) stay on the page, so disabling
    // them would just dead-lock the modal.
    document.addEventListener("submit", function (e) {
      var form = e.target;
      if (!form || form.tagName !== "FORM" || e.defaultPrevented) return;
      if (form.method === "dialog") return;
      setTimeout(function () { setFormLoading(form, true); }, 0);
    });

    // Mid-session SSE reconnect catch-up: hello carries full domain fingerprints
    // (revs). First open stores them (page HTML is already current). Later hellos
    // (reconnect) re-fetch only live-regions whose rev changed while offline.
    var lastLiveRevs = null;
    var liveDomains = ["dashboard", "ship", "cases", "history", "worktrees", "config", "deploy"];

    function applyLiveRevs(revs) {
      if (!revs) return;
      if (lastLiveRevs) {
        var changed = {};
        var any = false;
        for (var i = 0; i < liveDomains.length; i++) {
          var d = liveDomains[i];
          if ((lastLiveRevs[d] || "") !== (revs[d] || "")) {
            changed[d] = true;
            any = true;
          }
        }
        if (any) {
          document.querySelectorAll(".live-region[hx-get][hx-trigger]").forEach(function (el) {
            var trigger = el.getAttribute("hx-trigger") || "";
            var needs = false;
            for (var d in changed) {
              if (Object.prototype.hasOwnProperty.call(changed, d) &&
                  trigger.indexOf("sse:" + d) !== -1) {
                needs = true;
                break;
              }
            }
            if (!needs) return;
            htmx.ajax("GET", el.getAttribute("hx-get"), {
              source: el,
              target: el,
              swap: el.getAttribute("hx-swap") || "innerHTML",
              select: el.getAttribute("hx-select") || "unset"
            });
          });
        }
      }
      lastLiveRevs = revs;
    }

    function bindLiveRevTracking(source) {
      if (!source || source.__grokLiveRevsBound) return;
      source.__grokLiveRevsBound = true;
      // Unnamed hello event (domain fingerprints for reconnect sync).
      source.addEventListener("message", function (ev) {
        try {
          var data = JSON.parse(ev.data);
          if (data && data.revs) applyLiveRevs(data.revs);
        } catch (err) { /* ignore malformed */ }
      });
      // Keep lastLiveRevs current as domain ticks arrive during the session.
      liveDomains.forEach(function (name) {
        source.addEventListener(name, function (ev) {
          try {
            var data = JSON.parse(ev.data);
            if (!data || !data.rev) return;
            if (!lastLiveRevs) lastLiveRevs = {};
            lastLiveRevs[name] = data.rev;
          } catch (err) { /* ignore malformed */ }
        });
      });
    }

    document.body.addEventListener("htmx:sseOpen", function (e) {
      setStatus("live", "ok");
      var src = e.detail && e.detail.source;
      bindLiveRevTracking(src);
    });
    document.body.addEventListener("htmx:sseError", function () {
      setStatus("reconnecting…", "err");
    });

    // How close to the page bottom counts as "following" growing content.
    var PAGE_PIN_PX = 48;
    // Backup of the in-flight live-region window Y. Properties on the
    // element can be lost if the swap is outerHTML; afterSwap also sees
    // detail.elt (the source) which is not always the region.
    var livePageScroll = null;
    // Re-assert after layout. A large innerHTML swap (session turns) first
    // collapses document height, so one scrollTo is clamped to 0 and stays
    // there once the new markup is measured.
    function applyWindowScrollY(y) {
      if (typeof y !== "number") return;
      window.scrollTo(0, y);
      requestAnimationFrame(function () {
        window.scrollTo(0, y);
        requestAnimationFrame(function () {
          window.scrollTo(0, y);
        });
      });
    }
    function pinWindowBottom() {
      function go() { window.scrollTo(0, document.documentElement.scrollHeight); }
      go();
      requestAnimationFrame(function () {
        go();
        requestAnimationFrame(go);
      });
    }
    function liveRegionFromEvent(e) {
      var d = e.detail || {};
      var elt = d.target || d.elt || e.target;
      if (!elt || !elt.classList) return null;
      if (elt.classList.contains("live-region")) return elt;
      return elt.closest ? elt.closest(".live-region") : null;
    }
    function restoreLivePageScroll(elt) {
      var pin = (elt && elt._pagePinBottom) || (livePageScroll && livePageScroll.pin);
      var y = (elt && typeof elt._pageScrollY === "number")
        ? elt._pageScrollY
        : (livePageScroll && livePageScroll.y);
      if (pin) pinWindowBottom();
      else applyWindowScrollY(y);
    }

    // ── iOS-style page transitions (phone only) ───────────────────────
    // Arms a View Transition for a navigation and tells the <style> block
    // which way to slide. Nothing here animates: it sets data-gw-nav and the
    // caller opts the swap in (swapOverride "transition:true" for boosted
    // navigation, swapSpec.transition for history restore). htmx only reads
    // those per swap, so SSE live-region ticks never transition.
    //
    // Direction is a pure function of the two URLs, which is what makes
    // back/forward mirror the forward move with no history bookkeeping.
    // It is measured per nav scope (navScopeOf, the same derivation the
    // sidebar uses) because depth alone cannot place "/": it is the parent of
    // a workspace but a peer of the other global tabs. Within a scope every
    // tab-bar destination is level 1 and anything else is 1 + its segment
    // count, so a deeper URL is a deeper screen.
    var TAB_SECTIONS = { ship: 1, cases: 1, sessions: 1, reviews: 1 };
    // Detail families (same list as Go navScopeFromURL) are always leaf
    // screens even though their URLs are short: /projects/{p}/start is four
    // segments and redirects to a two-segment /sessions/{id}, so counting
    // alone would call creating a session a *back* move. Pin them below every
    // list and tab instead.
    var DETAIL_ROOTS = { sessions: 1, history: 1, prs: 1 };
    var LEAF_LEVEL = 99;
    function navLevel(loc) {
      var seg = loc.path.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean);
      if (!seg.length) return 1;                                   // "/" Projects tab
      if (DETAIL_ROOTS[seg[0]] && seg.length >= 2) return LEAF_LEVEL;
      if (loc.scope) {
        if (seg[0] === "projects") {
          if (seg.length === 2) return 1;                          // workspace home
          if (seg.length === 3 && TAB_SECTIONS[seg[2]]) return 1;  // workspace tab
        }
      } else if (seg.length === 1 && TAB_SECTIONS[seg[0]]) {
        return 1;                                                  // global tab
      }
      return 1 + seg.length;
    }
    function navLocOf(url) {
      var u;
      try {
        u = new URL(url, location.href);
      } catch (err) {
        u = location;
      }
      return { path: u.pathname, scope: navScopeOf(u.pathname, u.search) };
    }
    // Where the last *committed* navigation left us. Tracked off the history
    // events rather than advanced at swap time so an aborted or errored
    // request cannot strand the next transition on an origin we never reached.
    var navFrom = navLocOf(location.href);
    function navCommitted() {
      navFrom = navLocOf(location.href);
    }
    document.body.addEventListener("htmx:pushedIntoHistory", navCommitted);
    document.body.addEventListener("htmx:replacedInHistory", navCommitted);
    document.body.addEventListener("htmx:historyRestore", navCommitted);

    function navDirection(from, to) {
      // Crossing between the global shell and a project workspace is a
      // drill-in either way round; a sideways hop between two projects is not.
      if (from.scope !== to.scope) {
        if (!from.scope) return "push";
        if (!to.scope) return "pop";
        return "swap";
      }
      var delta = navLevel(to) - navLevel(from);
      return delta > 0 ? "push" : delta < 0 ? "pop" : "swap";
    }
    // htmx starts the transition and throws away the handle, so when one gets
    // skipped — starting a second transition skips the first, which is what
    // rapid tapping does — .ready rejects with nobody listening. Swallow that
    // rather than let it surface as an unhandled rejection.
    if (document.startViewTransition) {
      var startViewTransition = document.startViewTransition.bind(document);
      document.startViewTransition = function (cb) {
        var t = startViewTransition(cb);
        var quiet = function () {};
        t.ready.catch(quiet);
        t.finished.catch(quiet);
        return t;
      };
    }
    var reduceMotionMQ = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Returns true when the caller should opt this swap into a transition.
    function armNav(url) {
      if (!document.startViewTransition) return false;
      // Width is no longer a gate: the CSS carries a desktop character for the
      // same push/pop (see the --nav-* tokens), so both layouts animate and
      // neither needs the JS to know which one it is on.
      // The global prefers-reduced-motion rule cannot reach the
      // ::view-transition tree, so the opt-out has to happen here.
      if (reduceMotionMQ.matches) return false;
      document.documentElement.dataset.gwNav = navDirection(navFrom, navLocOf(url));
      return true;
    }

    // Browser back/forward restores from htmx's history cache without a
    // request, so it never reaches htmx:beforeSwap. detail.swapSpec is the
    // very object htmx passes to the swap, so setting transition on it here
    // is what gives back/forward its pop.
    var navRestoreArmed = false;
    document.body.addEventListener("htmx:historyCacheHit", function (e) {
      var d = e.detail;
      if (!d || !d.swapSpec) return;
      if (d.historyElt && d.historyElt.id !== "live-root") return;
      if (!armNav(d.path)) return;
      d.swapSpec.transition = true;
      navRestoreArmed = true;
    });
    // A transition makes htmx's restore asynchronous: it calls
    // startViewTransition and returns, so htmx:historyRestore fires against
    // the *outgoing* DOM. Consumers read that event to re-sync the restored
    // page (nav active state, diff-review setup at the bottom of this file),
    // so replay it from afterSettle, which runs inside the transition callback
    // once the DOM really has been restored.
    document.body.addEventListener("htmx:afterSettle", function () {
      if (!navRestoreArmed) return;
      navRestoreArmed = false;
      htmx.trigger(document.body, "htmx:historyRestore", { gwReplay: true });
    });

    // Boosted navigation must swap #live-root only. If live-region attrs leaked
    // onto a child link (disableInheritance not applied), htmx would target the
    // region with no select and nest a full layout — double sidebar/navbar.
    // Force shell swap when the response is a full document.
    document.body.addEventListener("htmx:beforeSwap", function (e) {
      var d = e.detail;
      if (!d) return;
      // SSE live-region swaps replace scrollable shells (innerHTML), which
      // would reset scroll positions on every domain tick.
      var target = d.target;
      if (target && target.classList && target.classList.contains("live-region")) {
        var xs = [];
        target.querySelectorAll(".table-scroll").forEach(function (el) {
          xs.push(el.scrollLeft || 0);
        });
        target._tableScrollX = xs;
        // Pin-to-bottom only when the page was already scrollable and the
        // user was near its tail. A short shell (pageMax <= 0) is both top
        // and bottom — treating it as pinned jumps list pages (issues table
        // hx-trigger=load, Actions workflows/runs) to the new bottom once
        // the tall partial swaps in. Preserve y=0 instead.
        var pageMax = document.documentElement.scrollHeight - window.innerHeight;
        var pageY = window.scrollY || 0;
        target._pageScrollY = pageY;
        target._pagePinBottom = pageMax > 0 && (pageMax - pageY) <= PAGE_PIN_PX;
        livePageScroll = { y: pageY, pin: target._pagePinBottom };
        // htmx default swap has no show:, but inherit/boost can still force
        // show:top and yank the session page to the live-region (the header).
        var swap = target.getAttribute("hx-swap") || "innerHTML";
        if (swap.indexOf("show:") === -1) {
          d.swapOverride = swap + " show:none focus-scroll:false";
        }
      }
      if (!d.boosted) return;
      var html = d.serverResponse || "";
      if (html.indexOf('id="live-root"') === -1) return;
      var root = document.getElementById("live-root");
      if (!root) return;
      d.target = root;
      d.selectOverride = "#live-root";
