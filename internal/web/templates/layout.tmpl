        // tail only if the user was already at the bottom. Re-applied in
        // afterSettle once the new turns have a real height.
        restoreLivePageScroll(elt);
      }
    });
    document.body.addEventListener("htmx:afterSettle", function (e) {
      if (e.detail && e.detail.boosted) return;
      var elt = liveRegionFromEvent(e);
      if (!elt && !livePageScroll) return;
      restoreLivePageScroll(elt);
