        (armNav(to) ? " transition:true" : "");
    });

    document.body.addEventListener("htmx:afterSwap", function (e) {
      // Invariant: one shell chrome. Nested full-page swaps leave a second
      // #side-nav inside main; recover with a hard reload.
      if (document.querySelectorAll("#side-nav").length > 1 ||
          document.querySelectorAll("aside.side").length > 1) {
        location.reload();
        return;
      }
      var elt = liveRegionFromEvent(e);
      if (elt) {
        // Desktop shows the clock; mobile setStatus strips it to "live".
        setStatus("live · " + new Date().toLocaleTimeString(), "ok");
        // Restore table horizontal scroll saved in beforeSwap.
        var xs = elt._tableScrollX;
        if (xs && xs.length) {
          var shells = elt.querySelectorAll(".table-scroll");
          for (var j = 0; j < shells.length && j < xs.length; j++) {
            if (xs[j]) shells[j].scrollLeft = xs[j];
          }
          delete elt._tableScrollX;
        }
