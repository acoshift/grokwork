{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {{/* maximum-scale=1 + user-scalable=no: native-app feel — blocks pinch/double-tap
       zoom on Android and iOS auto-zoom on input focus; iOS Safari ignores the meta
       for pinch gestures, so the gesturestart handler below covers it. */}}
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <title>{{.Title}} · Grok Work</title>
  <meta name="description" content="Run and ship agent work">
  <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Grok Work">
  <meta name="application-name" content="Grok Work">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180">
  {{/* Preload latin faces early so they race the HTML parse, not wait for
       @font-face discovery. crossorigin is required for font preloads (even
       same-origin) or the browser fetches twice and ignores the preload. */}}
  <link rel="preload" href="/static/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/ibm-plex-mono-500.woff2" as="font" type="font/woff2" crossorigin>
  {{/* htmx-config meta is merged synchronously at init (before processNode).
       Required so disableInheritance is on before any click: live-region
       hx-target/hx-select must not poison child links, or boosted nav nests a
       full page (double navbar). onload is a belt-and-suspenders copy for the
       same flags. scrollIntoViewOnBoost: boost forces show:top even with show:none. */}}
  <meta name="htmx-config" content='{"disableInheritance":true,"scrollIntoViewOnBoost":false}'>
  <script src="/static/htmx.min.js" defer
          onload="htmx.config.disableInheritance=true;htmx.config.scrollIntoViewOnBoost=false;"></script>
  <script src="/static/sse.js" defer></script>
  <script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/sw.js").catch(function () {});
    });
  }
  </script>
  <style>
    /* Self-hosted under /static/fonts — no third-party font CDN.
       font-display: block holds text invisible briefly until the face is
       ready (no system→Inter swap flash). With preload + long HTTP cache,
       a refresh usually paints Inter on the first frame. */
    @font-face {
      font-family: Inter;
      font-style: normal;
      font-weight: 100 900;
      font-display: block;
      src: url("/static/fonts/inter-latin-ext-var.woff2") format("woff2");
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: Inter;
      font-style: normal;
      font-weight: 100 900;
      font-display: block;
      src: url("/static/fonts/inter-latin-var.woff2") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
