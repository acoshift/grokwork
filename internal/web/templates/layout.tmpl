      // Workspace overview: exact match only (siblings extend the path).
      if (/^\/projects\/[^\/]+$/.test(href)) {
        return path === href;
      }
      // Workspace Ship/Sessions also cover detail pages living outside the
      // /projects/{p} prefix (/prs/…, /sessions/{id}, /history/{id}); scope already matched.
      if (href.slice(-5) === "/ship" || href === "/ship") {
        if (path.indexOf("/prs/") === 0) return true;
      }
      if (href.slice(-9) === "/sessions" || href === "/sessions") {
        if (path.indexOf("/sessions/") === 0 || path.indexOf("/history/") === 0) return true;
      }
      return path === href || path.indexOf(href + "/") === 0;
    }
    function updateNavActive() {
      var path = location.pathname || "/";
      document.querySelectorAll(".nav-links > a[href]").forEach(function (a) {
        var href = a.getAttribute("href") || "";
        a.classList.toggle("active", !!navActiveFor(path, href));
      });
      // Phone tab bar: its items are scope-aware server-side (oob swap), and
      // a scope mismatch on history restore reloads (below), so the anchors
      // always belong to the current scope — plain href matching suffices.
      document.querySelectorAll("#tab-bar > a[href]").forEach(function (a) {
        var href = a.getAttribute("href") || "";
        a.classList.toggle("active", !!navActiveFor(path, href));
      });
    }
    document.body.addEventListener("htmx:pushedIntoHistory", updateNavActive);
    document.body.addEventListener("htmx:replacedInHistory", updateNavActive);
    document.body.addEventListener("htmx:historyRestore", function () {
      var nav = document.getElementById("side-nav");
      if (!nav) return;
      var want = scopeFromLocation();
      var have = nav.getAttribute("data-scope") || "";
      if (want === have) {
        updateNavActive();
        return;
      }
      // Server may render a narrower scope than the URL implies (unknown or
      // forbidden project falls back to global) — guard against reload loops.
      var key = "gw-scope-reload:" + location.href;
      try {
        if (sessionStorage.getItem(key)) { updateNavActive(); return; }
        sessionStorage.setItem(key, "1");
      } catch (e) { updateNavActive(); return; }
      location.reload();
    });

    // Workspace switcher: close the dropdown when clicking elsewhere.
    document.addEventListener("click", function (e) {
      document.querySelectorAll("details.proj-switch[open]").forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute("open");
      });
    });

    // Account menu (phones only). The top bar has no room for a Log out
    // button, so the avatar opens a menu holding it; the desktop sidebar keeps
    // both visible and the avatar is decorative there — hence the width gate on
    // both the toggle and the ARIA. .side-user sits outside #live-root and the
    // #side-nav oob swap, so this wiring survives boosted navigation.
    (function () {
      var user = document.querySelector(".side-user");
      var btn = document.getElementById("user-menu-btn");
      if (!user || !btn) return;
      var phone = window.matchMedia("(max-width: 920px)");
      function close() {
        user.classList.remove("is-open");
        if (phone.matches) btn.setAttribute("aria-expanded", "false");
      }
      function syncMode() {
        close();
        if (phone.matches) {
          btn.removeAttribute("aria-hidden");
          btn.removeAttribute("tabindex");
          btn.setAttribute("aria-expanded", "false");
        } else {
          btn.removeAttribute("aria-expanded");
          btn.setAttribute("aria-hidden", "true");
          btn.setAttribute("tabindex", "-1");
        }
      }
      btn.addEventListener("click", function (e) {
        if (!phone.matches) return;
        e.stopPropagation();
        var open = !user.classList.contains("is-open");
        user.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
      document.addEventListener("click", function (e) {
        if (user.classList.contains("is-open") && !user.contains(e.target)) close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && user.classList.contains("is-open")) {
          close();
          btn.focus();
        }
      });
      // A tab tap navigates without unloading the shell — drop the menu too.
      // Boosted only: SSE region refreshes also fire this and must not close it.
      document.body.addEventListener("htmx:beforeRequest", function (e) {
        if (e.detail && e.detail.boosted) close();
      });
      if (phone.addEventListener) phone.addEventListener("change", syncMode);
      else phone.addListener(syncMode);
      syncMode();
    })();

    // Detail-page action sheet (phones only). All state is one body class —
    // the rail itself is page content inside #live-root and is never touched,
    // so a boosted swap can replace it wholesale without this script caring.
    // Same reason the queries are re-run per call rather than cached: the
    // element answering .pr-rail today is not the one that will answer after
    // the next navigation.
    (function () {
      var fab = document.getElementById("rail-fab");
      if (!fab) return;
      var OPEN = "rail-sheet-open";
      function rail() { return document.querySelector(".pr-rail"); }
      function isOpen() { return document.body.classList.contains(OPEN); }
      function open() {
        var r = rail();
        if (!r || isOpen()) return;
        document.body.classList.add(OPEN);
        fab.setAttribute("aria-expanded", "true");
        // Pre-26 Safari still honors theme-color; dim it with the scrim.
        setThemeColorTint(true);
        var x = r.querySelector("[data-rail-close]");
        if (x) x.focus();
      }
      // iOS Safari samples fixed overlays for browser-chrome tint and can keep
      // the scrim's color after dismiss. Re-assert the page background on
      // <html> + theme-color so the title bar re-samples --bg.
      function setThemeColorTint(dim) {
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) {
          var m = metas[i];
          if (!m.dataset.gwThemeBase) m.dataset.gwThemeBase = m.getAttribute("content") || "";
          if (dim) {
            // Match color-mix(#000 38%, --bg) approximately for the two themes.
            var dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            m.setAttribute("content", dark ? "#0c0c0c" : "#9a9a9a");
          } else {
            m.setAttribute("content", m.dataset.gwThemeBase);
          }
        }
      }
      function resyncChromeTint() {
        setThemeColorTint(false);
        if (isOpen()) return;
        var root = document.documentElement;
        // Stamp the resolved page bg, flush, then hand ownership back to the
        // CSS token so scheme flips stay live. The paint change is what makes
        // Safari re-sample the title bar off the dismissed scrim.
        root.style.backgroundColor = getComputedStyle(document.body).backgroundColor;
        void root.offsetHeight;
        requestAnimationFrame(function () {
          if (!isOpen()) root.style.backgroundColor = "";
        });
      }
      // refocus only on a deliberate dismissal: after a navigation the button
      // may be gone, and stealing focus mid-swap fights the new page.
      function close(refocus) {
        if (!isOpen()) return;
        document.body.classList.remove(OPEN);
        fab.setAttribute("aria-expanded", "false");
        if (refocus) fab.focus();
        resyncChromeTint();
        // Scrim visibility delay is 0.24s; re-assert once it has left the
        // fixed-element sample pool.
        setTimeout(resyncChromeTint, 280);
      }
      fab.addEventListener("click", function () {
        if (isOpen()) close(true); else open();
      });
      document.addEventListener("click", function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        if (t.closest("[data-rail-close]")) { close(true); return; }
        // A link in the rail navigates; drop the sheet so the destination does
        // not arrive with one already raised. Forms need no such rule — their
        // boosted POST closes it through htmx:beforeRequest below.
        if (isOpen() && t.closest(".pr-rail a[href]")) close(false);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape" || !isOpen()) return;
        // A rail form's data-confirm opens a modal <dialog> over the sheet.
        // Esc belongs to the dialog then — closing the sheet under it would
        // disconnect the form the confirm is about to re-submit.
        if (document.querySelector("dialog[open]")) return;
        close(true);
      });
      // Boosted only, exactly as the account menu above: SSE region refreshes
      // fire beforeRequest too and must not shut a sheet being used.
      document.body.addEventListener("htmx:beforeRequest", function (e) {
        if (e.detail && e.detail.boosted) close(false);
      });
      // Back/forward is served from htmx's history cache with no request, so
      // beforeRequest never fires for it.
      document.body.addEventListener("htmx:historyCacheHit", function () { close(false); });
      document.body.addEventListener("htmx:historyRestore", function () { close(false); });
    })();

    // Per-path scroll for boosted navigations (e.g. history detail → list via
    // "← History"). show:none keeps the *leaving* page's scrollY; without this
    // the list jumps to top or to the detail offset.
    //
    // Drill-in (push: list→detail) always lands at y=0 — even when the
    // destination was visited before and the map still holds a mid/bottom
    // offset (issue pages with long comment threads are the usual case).
    // Pop/swap restore the map so "← Issues" returns to the list position.
    // Browser back/forward uses htmx's own history-cache scroll and can ignore this map.
    var boostScrollByPath = Object.create(null);
    // Path we left on the in-flight boost. navFrom is advanced on
    // pushedIntoHistory (before afterSettle), so direction must be measured
    // against this rather than navFrom at settle time.
    var boostScrollFromPath = "";
    function pagePath() {
      return location.pathname + location.search;
    }
    function applyBoostScrollY(y) {
      applyWindowScrollY(y);
    }
    document.body.addEventListener("htmx:beforeRequest", function (e) {
      var d = e.detail;
      if (!d || !d.boosted) return;
      var path = pagePath();
      boostScrollByPath[path] = window.scrollY || 0;
      boostScrollFromPath = path;
    });
    document.body.addEventListener("htmx:afterSettle", function (e) {
      var d = e.detail;
      if (!d || !d.boosted) return;
      loaderStop();
      var elt = d.elt;
      if (!elt || elt.id !== "live-root") return;
      var path = pagePath();
      var from = boostScrollFromPath
        ? navLocOf(boostScrollFromPath)
        : navFrom;
      var dir = navDirection(from, navLocOf(location.href));
      var y = 0;
      if (dir === "push") {
        // Fresh detail screen: never inherit a previous mid-page offset.
        boostScrollByPath[path] = 0;
      } else if (Object.prototype.hasOwnProperty.call(boostScrollByPath, path)) {
        y = boostScrollByPath[path];
      }
      applyBoostScrollY(y);
    });

    if (!{{json .SSEPath}}) {
      setStatus("offline", "err");
    }

    // ── Diff review (commit / session / PR diffs) ─────────────────────
    // The page ships a file index; hunks load per file (htmx intersect /
    // click). This module adds viewed-tracking (localStorage, keyed by the
    // #diff-review data-review-key), filtering, scroll-spy, and j/k/v/o
    // keyboard review. Delegated listeners survive hx-boost swaps; setup()
    // re-applies state after each navigation.
    (function () {
      var spy = null;
      var currentIdx = -1;

      function root() { return document.getElementById("diff-review"); }
      function storeKey(r) { return "gw-viewed:" + (r.getAttribute("data-review-key") || ""); }
      function loadViewed(r) {
        try { return new Set(JSON.parse(localStorage.getItem(storeKey(r)) || "[]")); }
        catch (e) { return new Set(); }
      }
      function saveViewed(r, set) {
        try { localStorage.setItem(storeKey(r), JSON.stringify(Array.from(set))); } catch (e) {}
      }
      function cards(r) { return Array.prototype.slice.call(r.querySelectorAll(".fcard")); }
      function railRow(r, idx) { return r.querySelector('.rrow[data-rv-row="' + idx + '"]'); }
      function updateProgress(r) {
        var total = r.querySelectorAll(".fcard").length;
        var done = r.querySelectorAll(".fcard.is-viewed").length;
        var d = r.querySelector("[data-rv-done]");
        if (d) d.textContent = String(done);
        var m = r.querySelector("[data-rv-meter]");
        if (m) m.style.width = total ? (100 * done / total) + "%" : "0%";
      }
      function applyViewed(r, card, on) {
        card.classList.toggle("is-viewed", on);
        var cb = card.querySelector("[data-rv-viewed]");
        if (cb) cb.checked = on;
        var row = railRow(r, card.getAttribute("data-rv-card"));
        if (row) row.classList.toggle("viewed", on);
      }
      function setViewed(r, card, on) {
        var set = loadViewed(r);
        var path = card.getAttribute("data-path") || "";
        if (on) set.add(path); else set.delete(path);
        saveViewed(r, set);
        applyViewed(r, card, on);
        updateProgress(r);
      }
      function setCurrent(r, card, outline) {
        var prev = r.querySelector(".fcard.is-current");
        if (prev && prev !== card) prev.classList.remove("is-current");
        var prevRow = r.querySelector(".rrow.active");
        if (prevRow) prevRow.classList.remove("active");
        if (!card) { currentIdx = -1; return; }
        currentIdx = parseInt(card.getAttribute("data-rv-card"), 10);
        if (outline) card.classList.add("is-current");
        var row = railRow(r, card.getAttribute("data-rv-card"));
        if (row) {
          row.classList.add("active");
          if (row.scrollIntoView) row.scrollIntoView({ block: "nearest" });
        }
      }
      function visibleCards(r) {
        return cards(r).filter(function (c) { return c.style.display !== "none"; });
      }
      function loadCard(card) {
        var auto = card.querySelector(".fbody [hx-get][hx-trigger]");
        if (auto && window.htmx) { htmx.trigger(auto, "intersect"); return; }
        var btn = card.querySelector("[data-rv-load]");
        if (btn) btn.click();
      }

      function setup() {
        var r = root();
        if (spy) { spy.disconnect(); spy = null; }
        currentIdx = -1;
        if (!r) return;
        var set = loadViewed(r);
        cards(r).forEach(function (card) {
          applyViewed(r, card, set.has(card.getAttribute("data-path") || ""));
        });
        updateProgress(r);
        if (window.IntersectionObserver) {
          spy = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                setCurrent(r, entries[i].target, false);
                break;
              }
            }
          }, { rootMargin: "-15% 0px -70% 0px" });
          cards(r).forEach(function (c) { spy.observe(c); });
        }
      }

      document.addEventListener("click", function (e) {
        var r = root();
        if (!r || !e.target.closest) return;
        var fold = e.target.closest("[data-rv-fold]");
        if (fold && r.contains(fold)) {
          fold.closest(".fcard").classList.toggle("folded");
          return;
        }
        var row = e.target.closest("[data-rv-row]");
        if (row && r.contains(row)) {
          var card = document.getElementById("df-" + row.getAttribute("data-rv-row"));
          if (card) setCurrent(r, card, true);
          return;
        }
        if (e.target.closest("[data-rv-expand]")) {
          cards(r).forEach(function (card) {
            card.classList.remove("folded");
            if (!card.hasAttribute("data-gen")) loadCard(card);
          });
          return;
        }
        if (e.target.closest("[data-rv-collapse]")) {
          cards(r).forEach(function (card) { card.classList.add("folded"); });
        }
      });

      document.addEventListener("change", function (e) {
        var r = root();
        if (!r || !e.target.matches || !e.target.matches("[data-rv-viewed]")) return;
        setViewed(r, e.target.closest(".fcard"), e.target.checked);
      });

      var filterTimer = 0;
      document.addEventListener("input", function (e) {
        var r = root();
        if (!r || !e.target.matches || !e.target.matches("[data-rv-filter]")) return;
        var q = e.target.value.trim().toLowerCase();
        clearTimeout(filterTimer);
        filterTimer = setTimeout(function () {
          cards(r).forEach(function (card) {
            var hit = !q || (card.getAttribute("data-path") || "").toLowerCase().indexOf(q) >= 0;
            card.style.display = hit ? "" : "none";
            var row = railRow(r, card.getAttribute("data-rv-card"));
            if (row) row.style.display = hit ? "" : "none";
          });
          r.querySelectorAll(".rgroup").forEach(function (g) {
            var any = Array.prototype.some.call(g.querySelectorAll(".rrow"), function (row) {
              return row.style.display !== "none";
            });
            g.style.display = any ? "" : "none";
          });
        }, 80);
      });

      document.addEventListener("keydown", function (e) {
        var r = root();
        if (!r) return;
        var t = e.target;
        if (t instanceof Element && t.matches("input, textarea, select")) {
          if (e.key === "Escape") t.blur();
          return;
        }
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === "/") {
          var f = r.querySelector("[data-rv-filter]");
          if (f) { e.preventDefault(); f.focus(); }
          return;
        }
        var vis = visibleCards(r);
        if (!vis.length) return;
        var pos = -1;
        for (var i = 0; i < vis.length; i++) {
          if (parseInt(vis[i].getAttribute("data-rv-card"), 10) === currentIdx) { pos = i; break; }
        }
        function go(card) {
          setCurrent(r, card, true);
          card.scrollIntoView({ block: "start" });
        }
        if (e.key === "j" || e.key === "k") {
          e.preventDefault();
          go(vis[e.key === "j" ? Math.min(pos + 1, vis.length - 1) : Math.max(pos - 1, 0)]);
        } else if (e.key === "v" && pos >= 0) {
          var cur = vis[pos];
          var on = !cur.classList.contains("is-viewed");
          setViewed(r, cur, on);
          if (on && pos < vis.length - 1) go(vis[pos + 1]);
        } else if (e.key === "o" && pos >= 0) {
          vis[pos].classList.toggle("folded");
        }
      });

      document.body.addEventListener("htmx:afterSettle", function (e) {
        var elt = e.detail && e.detail.elt;
        if (elt && elt.id === "live-root") setup();
      });
      document.body.addEventListener("htmx:historyRestore", setup);
      setup();
    })();
  })();
  </script>
</body>
</html>
{{end}}
{{define "csrf"}}{{if .CSRF}}<input type="hidden" name="csrf" value="{{.CSRF}}">{{end}}{{end}}
{{/* Scrim for the phone action sheet. Rendered immediately before the rail, so
     it lands in the same stacking context and can sit between the composer and
     the sheet — no <body>-level z-index can do that once #live-root is lifted.
     Inert and invisible until body.rail-sheet-open; display:none above the
     phone breakpoint, so on desktop it is not even a paint. */}}
{{define "rail_scrim"}}<div class="rail-scrim" id="rail-scrim" data-rail-close></div>{{end}}
{{/* Sheet header for a detail-page rail. Rendered by every .pr-rail as its
     first child and display:none above the phone breakpoint, so on desktop it
     is neither drawn nor focusable — the rail is an ordinary column there.
     It lives in the rail rather than in the shell because it has to scroll
     (sticky) with the sheet it titles, and because its Close button belongs in
     the sheet's tab order, not the page's. */}}
{{define "rail_sheet_head"}}
<div class="rail-sheet-head">
  <span class="rail-sheet-grip" aria-hidden="true"></span>
  <span class="rail-sheet-title">Actions</span>
  <button type="button" class="rail-sheet-x" data-rail-close aria-label="Close actions">
    {{/* SF Symbol xmark — bold weight, round caps (matches system exit control). */}}
    <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
      <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>
</div>
{{end}}
{{/* Model dropdowns. Options are grouped by the CLI each name routes to, so the
     derived agent is visible at the point of choice rather than only after
     saving. Defined here because both the config page and the dispatch pages
     need them and each page is its own template set. */}}
{{define "model_optgroups"}}
{{- range .}}
<optgroup label="{{.Label}}">
  {{- range .Choices}}
  <option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>
  {{- end}}
</optgroup>
{{- end}}
{{- end}}
{{/* model_picker_options is the dispatch-side list: no selection (a page can only
     start a new session, never re-point an existing one) and a leading Default
     naming what config would pick. Callers own the <select> — the start composer
     shows it, the dispatch cards hide it and feed it to the confirm modal. */}}
{{define "model_picker_options"}}<option value="">Default ({{.ModelDefaultLabel}})</option>
{{- template "model_optgroups" .ModelGroups}}
{{- end}}
