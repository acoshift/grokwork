      // session page) must be measured against where it landed, not where it
      // was sent.
      var to =
        (d.xhr && d.xhr.responseURL) ||
        (d.pathInfo && (d.pathInfo.finalRequestPath || d.pathInfo.requestPath)) ||
        location.href;
