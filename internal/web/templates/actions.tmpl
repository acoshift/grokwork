{{define "content"}}
<h1 id="page-actions">{{.Project}} <span class="muted" style="font-weight:500;font-size:0.95rem">· actions</span></h1>
<p class="sub">
  {{if .ActiveRepo}}Repo: <span class="mono">{{.ActiveOwner}}/{{.ActiveRepo}}</span>{{else}}GitHub Actions workflows and recent runs{{end}}
</p>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{if gt (len .RepoCatalog) 0}}
<div class="toolbar" id="actions-toolbar">
<form method="get" action="/projects/{{.Project}}/actions" id="actions-filter" style="display:contents">
  {{if gt (len .RepoCatalog) 1}}
  <div class="field" style="flex-basis:18rem">
    <label for="actions-repo-pick">Repository</label>
    <select id="actions-repo-pick" name="repo_full" data-autosubmit>
      {{range .RepoCatalog}}
      <option value="{{.Owner}}/{{.Repo}}" {{if and (eq .Owner $.ActiveOwner) (eq .Repo $.ActiveRepo)}}selected{{end}}>{{.Owner}}/{{.Repo}}</option>
      {{end}}
    </select>
  </div>
  {{end}}
  <input type="hidden" name="owner" value="{{.ActiveOwner}}">
  <input type="hidden" name="repo" value="{{.ActiveRepo}}">
  <div class="field">
    <label for="actions-branch">Branch</label>
    <input id="actions-branch" type="text" name="branch" value="{{.ActionsBranchFilter}}" placeholder="any" class="mono" autocomplete="off">
  </div>
  <button type="submit" class="btn-secondary">Apply</button>
</form>
</div>
{{end}}

{{if .ActiveRepo}}
<div class="section">
  <h2>Workflows</h2>
  <div class="live-region" id="live-actions-workflows"
       hx-get="/partials/projects/{{.Project}}/actions/workflows?owner={{urlquery .ActiveOwner}}&amp;repo={{urlquery .ActiveRepo}}"
       hx-trigger="load"
       hx-target="this" hx-select="unset" hx-swap="innerHTML"
       hx-sync="this:queue last">
    {{template "actions_skeleton" .}}
  </div>
</div>

<div class="section">
  <h2>Recent runs</h2>
  <div class="live-region" id="live-actions-runs"
       hx-get="/partials/projects/{{.Project}}/actions/runs?owner={{urlquery .ActiveOwner}}&amp;repo={{urlquery .ActiveRepo}}&amp;workflow={{urlquery .ActionsWorkflowFilter}}&amp;branch={{urlquery .ActionsBranchFilter}}"
       hx-trigger="load, every 15s"
       hx-target="this" hx-select="unset" hx-swap="innerHTML"
       hx-sync="this:queue last">
    {{template "actions_skeleton" .}}
  </div>
</div>
{{else if not .Error}}
<div class="empty">No repository selected. Configure GitHub repos on project settings, or ensure git remotes exist.</div>
{{end}}
{{end}}

{{define "actions_skeleton"}}
<div class="skel-rows" aria-hidden="true">
  <div class="skel-row"><div class="skel-bar" style="width:38%"></div></div>
  <div class="skel-row"><div class="skel-bar" style="width:54%"></div></div>
  <div class="skel-row"><div class="skel-bar" style="width:46%"></div></div>
</div>
{{end}}

{{define "actions_workflows"}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}
{{if .ActionsWorkflows}}
<div class="wf-register">
  {{range .ActionsWorkflows}}
  {{if and .Dispatchable $.CanGitHubWrite}}
  <details class="wf-row wf-openable">
    <summary class="wf-line">
      <span class="wf-dot{{if ne .State "active"}} off{{end}}" title="{{.State}}"></span>
      <span class="wf-main">
        <span class="wf-name">{{.Name}}</span>
        <span class="wf-path mono">{{.Path}}</span>
      </span>
      <span class="wf-meta">
        {{if ne .State "active"}}<span class="wf-tag">{{.State}}</span>{{end}}
        {{if .Locked}}<span class="wf-tag lock" title="Dispatch limited to configured branches">locked · {{range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b}}{{end}}</span>{{end}}
        <span class="wf-tag run">manual</span>
      </span>
    </summary>
    <div class="wf-launch">
      {{$wfid := .ID}}
      <form method="post" action="/projects/{{$.Project}}/actions/dispatch"
            data-confirm="Dispatch {{.Name}} on the selected branch?"
            data-confirm-title="Run workflow" data-confirm-ok="Dispatch">
        {{template "csrf" $}}
        <input type="hidden" name="owner" value="{{$.ActiveOwner}}">
        <input type="hidden" name="repo" value="{{$.ActiveRepo}}">
        <input type="hidden" name="workflow" value="{{.Path}}">
        <div class="wf-fields">
          <div class="field">
            <label for="ref-{{.ID}}">Branch</label>
            {{if .Branches}}
            <select id="ref-{{.ID}}" name="ref" required class="mono">
              {{range .Branches}}
              <option value="{{.}}">{{.}}</option>
              {{end}}
            </select>
            {{else}}
            <input id="ref-{{.ID}}" type="text" name="ref" required class="mono" placeholder="main" autocomplete="off">
            {{end}}
          </div>
          {{range .Inputs}}
          <div class="field">
            {{if eq .Type "boolean"}}
            <label class="check" style="margin-top:1.35rem">
              <input type="checkbox" name="input.{{.Name}}" value="true" {{if or (eq .Default "true") (eq .Default "True")}}checked{{end}}>
              {{.Name}}{{if .Required}} *{{end}}
            </label>
            {{else if eq .Type "choice"}}
            <label for="input-{{$wfid}}-{{.Name}}" {{if .Description}}title="{{.Description}}"{{end}}>{{.Name}}{{if .Required}} *{{end}}</label>
            <select id="input-{{$wfid}}-{{.Name}}" name="input.{{.Name}}" class="mono" {{if .Required}}required{{end}}>
              {{$def := .Default}}
              {{range .Options}}
              <option value="{{.}}" {{if eq . $def}}selected{{end}}>{{.}}</option>
              {{end}}
            </select>
            {{else}}
            <label for="input-{{$wfid}}-{{.Name}}" {{if .Description}}title="{{.Description}}"{{end}}>{{.Name}}{{if .Required}} *{{end}}</label>
            <input id="input-{{$wfid}}-{{.Name}}" type="text" name="input.{{.Name}}"
                   value="{{.Default}}" class="mono" {{if .Required}}required{{end}} autocomplete="off">
            {{end}}
          </div>
          {{end}}
        </div>
        <div class="wf-launch-actions">
          {{if .Locked}}<span class="wf-locknote">Locked to: {{range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b}}{{end}}</span>{{end}}
          <button type="submit">Run workflow</button>
        </div>
      </form>
    </div>
  </details>
  {{else}}
  <div class="wf-row">
    <div class="wf-line">
      <span class="wf-dot{{if ne .State "active"}} off{{end}}" title="{{.State}}"></span>
      <span class="wf-main">
        <span class="wf-name">{{.Name}}</span>
        <span class="wf-path mono">{{.Path}}</span>
      </span>
      <span class="wf-meta">
        {{if ne .State "active"}}<span class="wf-tag">{{.State}}</span>{{end}}
        {{if .Locked}}<span class="wf-tag lock" title="Dispatch limited to configured branches">locked · {{range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b}}{{end}}</span>{{end}}
        {{if .Dispatchable}}<span class="wf-tag run" title="Dispatching needs GitHub write permission for this project">manual</span>{{end}}
      </span>
    </div>
  </div>
  {{end}}
  {{end}}
</div>
{{if not $.CanGitHubWrite}}
<p class="sub muted" style="margin:0.5rem 0 0">Dispatching needs GitHub write permission for this project.</p>
{{end}}
{{else if not .Error}}
<div class="empty">No workflows found.</div>
{{end}}
{{end}}

{{define "actions_runs"}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}
{{if .ActionsWorkflowFilter}}
<p class="sub" style="margin:0 0 0.5rem">Filtered to one workflow ·
  <a href="/projects/{{.Project}}/actions?owner={{urlquery .ActiveOwner}}&amp;repo={{urlquery .ActiveRepo}}{{if .ActionsBranchFilter}}&amp;branch={{urlquery .ActionsBranchFilter}}{{end}}">clear</a></p>
{{end}}
{{if .ActionsRuns}}
<div class="table-scroll">
<table>
  <thead>
    <tr>
      <th>Status</th>
      <th>Title</th>
      <th>Workflow</th>
      <th>Branch</th>
      <th>Event</th>
      <th>Age</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  {{range .ActionsRuns}}
    <tr>
      <td>
        <span class="badge {{runBucketBadge .Bucket}}">{{if .Conclusion}}{{.Conclusion}}{{else}}{{.Status}}{{end}}</span>
      </td>
      <td>
        <a class="pr-title" href="/projects/{{$.Project}}/actions/runs/{{.ID}}?owner={{urlquery $.ActiveOwner}}&amp;repo={{urlquery $.ActiveRepo}}">{{if .Title}}{{.Title}}{{else}}#{{.Number}}{{end}}</a>
      </td>
      <td class="mono">{{if .WorkflowID}}<a href="/projects/{{$.Project}}/actions?owner={{urlquery $.ActiveOwner}}&amp;repo={{urlquery $.ActiveRepo}}&amp;workflow={{.WorkflowID}}" title="Filter runs to this workflow">{{.WorkflowName}}</a>{{else}}{{.WorkflowName}}{{end}}</td>
      <td class="mono">{{.Branch}}{{if .ShortSHA}} <span class="muted">@ {{.ShortSHA}}</span>{{end}}</td>
      <td class="muted">{{.Event}}</td>
      <td class="mono muted">{{if not .CreatedAt.IsZero}}{{shortTime .CreatedAt}}{{end}}</td>
      <td>{{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener" hx-boost="false">GitHub</a>{{end}}</td>
    </tr>
  {{end}}
  </tbody>
</table>
</div>
{{else if not .Error}}
<div class="empty">No recent runs.</div>
{{end}}
{{end}}
