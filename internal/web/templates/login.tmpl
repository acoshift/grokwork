{{define "content"}}
{{/* The gate: mark, nameplate, one action per configured login provider, and
     one button that continues to the token page. The token field is that
     next page — the first screen stays a column of actions. All layout/CSS
     lives in layout.tmpl ("Login gate" section). Deliberately no policy
     copy: who may continue is answered by the error flash on the one
     attempt where it matters. */}}
<div class="login" id="{{if .LoginTokenStep}}page-login-token{{else}}page-login{{end}}">
  <span class="login-mark" aria-hidden="true"></span>
  <h1>Grok Work</h1>
  <span class="login-seam" aria-hidden="true"></span>
  {{if .Error}}
  <div class="flash err login-flash" role="alert">{{.Error}}</div>
  {{end}}
  {{if .LoginTokenStep}}
  {{/* Full navigation: the response sets the session cookie, which a boosted
       swap would not apply as a document load. */}}
  <form class="login-token" id="login-token-form" method="post" action="{{route "login"}}" hx-boost="false">
    {{if .LoginNext}}<input type="hidden" name="next" value="{{.LoginNext}}">{{end}}
    <label for="login-token">Login token</label>
    <input type="password" name="token" id="login-token" autocomplete="off" spellcheck="false" required autofocus>
    <button type="submit" class="btn" id="login-token-submit">Log in</button>
  </form>
  <a class="login-back" id="login-token-back" href="{{route "login"}}{{if .LoginNext}}?next={{urlquery .LoginNext}}{{end}}" hx-boost="false">Back</a>
  {{else}}
  {{/* Full navigation on every provider: hx-boost would AJAX /auth/<p> then
       follow the provider's OAuth redirect with HX-Request, which their CORS
       rejects. The token step is a full page too, so the field receives
       focus on arrival. */}}
  {{range .LoginProviders}}
  <a class="btn login-cta" data-provider="{{.Key}}" href="{{.StartPath}}{{if $.LoginNext}}?next={{urlquery $.LoginNext}}{{end}}"
     hx-boost="false" id="login-{{.Key}}">Log in with {{.Label}}</a>
  {{end}}
  {{if not .LoginProviders}}
  {{/* Reachable by misconfiguration (a credential removed from the environment
       at runtime). Say what is missing rather than offer a provider button
       that cannot start. The token button below is still a way in. */}}
  <p class="login-empty">No login providers are configured. An administrator must set
    <code>discordClientId</code>/<code>discordClientSecret</code> or
    <code>webAuth.providers</code> in <code>config.json</code>, plus
    <code>webPublicBaseURL</code>.</p>
  {{end}}
  <a class="btn login-token-go" id="login-with-token" href="{{route "login.token"}}{{if .LoginNext}}?next={{urlquery .LoginNext}}{{end}}" hx-boost="false">Log in with token</a>
  {{end}}
</div>
{{end}}
