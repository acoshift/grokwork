{{define "content"}}
{{/* The gate: mark, nameplate, one action. All layout/CSS lives in layout.tmpl
     ("Login gate" section) — this page is markup only. Deliberately no policy
     copy: who may continue is answered by the error flash on the one attempt
     where it matters. */}}
<div class="login" id="page-login">
  <span class="login-mark" aria-hidden="true"></span>
  <h1>Grok Work</h1>
  <span class="login-seam" aria-hidden="true"></span>
  {{if .Error}}
  <div class="flash err login-flash" role="alert">{{.Error}}</div>
  {{end}}
  {{/* Full navigation: hx-boost would AJAX /auth/discord then follow the Discord
       OAuth redirect with HX-Request, which Discord CORS rejects. */}}
  <a class="btn login-cta" href="{{route "auth.discord"}}{{if .LoginNext}}?next={{urlquery .LoginNext}}{{end}}"
     hx-boost="false" id="login-discord">Log in with Discord</a>
</div>
{{end}}
