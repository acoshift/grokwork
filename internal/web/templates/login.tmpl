{{define "content"}}
{{/* The gate: mark, nameplate, one action. All layout/CSS lives in layout.tmpl
     ("Login gate" section) — this page is markup only. Deliberately no policy
     copy: who may continue is answered by the error flash on the one attempt
     where it matters. */}}
<div class="login" id="page-login">
  <span class="login-mark" aria-hidden="true"></span>
  <h1>Grok Work</h1>
  <span class="login-seam" aria-hidden="true"></span>
  {{if .Error}}
  <div class="flash err login-flash" role="alert">{{.Error}}</div>
  {{end}}
  {{/* Full navigation: hx-boost would AJAX /auth/discord then follow the Discord
       OAuth redirect with HX-Request, which Discord CORS rejects. */}}
  <a class="btn login-cta" href="{{route "auth.discord"}}{{if .LoginNext}}?next={{urlquery .LoginNext}}{{end}}"
     hx-boost="false" id="login-discord">Log in with Discord</a>
  {{/* Password form only when accounts are provisioned: offering it with none
       configured would invite guesses at credentials that cannot exist. */}}
  {{if .LocalLoginEnabled}}
  <span class="login-seam" aria-hidden="true"></span>
  <form class="login-local" method="post" action="{{route "auth.local"}}" hx-boost="false" id="login-local">
    {{if .LoginNext}}<input type="hidden" name="next" value="{{.LoginNext}}">{{end}}
    <label class="sr-only" for="login-username">Username</label>
    <input id="login-username" name="username" autocomplete="username" placeholder="username" required>
    <label class="sr-only" for="login-password">Password</label>
    <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="password" required>
    <button class="btn" type="submit">Log in</button>
  </form>
  {{end}}
</div>
{{end}}
