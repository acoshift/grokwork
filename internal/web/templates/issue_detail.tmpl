{{define "content"}}
{{$open := eq .Issue.State "open" "OPEN"}}
<p class="pr-crumb">
  <a href="/projects/{{.Project}}/issues?owner={{urlquery .ActiveOwner}}&amp;repo={{urlquery .ActiveRepo}}">← Issues</a>
  <span class="crumb-sep">/</span>
  <span class="mono">{{.ActiveOwner}}/{{.ActiveRepo}}#{{.Issue.Number}}</span>
</p>
<div class="pr-title-row">
  <h1 id="page-issue-detail">{{if .Issue.Title}}{{.Issue.Title}}{{else}}{{.ActiveOwner}}/{{.ActiveRepo}}#{{.Issue.Number}}{{end}}</h1>
  <div class="pr-head-links">
    {{if .Issue.URL}}<a class="btn btn-compact" href="{{.Issue.URL}}" target="_blank" rel="noopener">GitHub ↗</a>{{end}}
  </div>
</div>
<div class="pr-meta">
  {{if eq .Issue.WorkState "FIXING"}}
  <span class="badge status-fixing" title="Active Grok fix session">FIXING</span>
  {{else if $open}}
  <span class="badge live">{{.Issue.State}}</span>
  {{else if .Issue.State}}
  <span class="badge">{{.Issue.State}}</span>
  {{end}}
  {{if .Issue.Author}}<span class="mono">{{.Issue.Author}}</span>{{end}}
  {{range .Issue.Labels}}<span class="badge">{{.}}</span>{{end}}
  {{if .Issue.Truncated}}<span class="muted">body truncated</span>{{end}}
</div>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

<div class="pr-cols">
<div class="pr-main">

<div class="section card">
  <h2>Description</h2>
  {{if .Issue.Body}}<div class="md">{{markdown .Issue.Body}}</div>{{else}}<p class="muted" style="margin:0">No description.</p>{{end}}
</div>

{{if .Issue.LinkedPRs}}
<div class="section card" id="issue-linked-prs">
  <h2>Related PRs <span class="muted" style="font-weight:500;font-size:0.9rem">({{len .Issue.LinkedPRs}})</span></h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th>#</th><th>Title</th><th>State</th><th>Repo</th></tr></thead>
    <tbody>
    {{range .Issue.LinkedPRs}}
      <tr>
        <td class="mono">
          {{if and .Owner .Repo .Number}}
          <a href="/prs/{{.Owner}}/{{.Repo}}/{{.Number}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">#{{.Number}}</a>
          {{else}}
          #{{.Number}}
          {{end}}
          {{if .URL}} <a href="{{.URL}}" target="_blank" rel="noopener" title="Open on GitHub">↗</a>{{end}}
        </td>
        <td>
          {{if and .Owner .Repo .Number}}
          <a class="pr-title" href="/prs/{{.Owner}}/{{.Repo}}/{{.Number}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">{{if .Title}}{{.Title}}{{else}}#{{.Number}}{{end}}</a>
          {{else if .Title}}{{.Title}}{{else}}<span class="muted">—</span>{{end}}
        </td>
        <td>
          {{if eq .State "OPEN"}}
          <span class="badge live">{{.State}}</span>
          {{else if eq .State "MERGED"}}
          <span class="badge status-merged">{{.State}}</span>
          {{else if eq .State "CLOSED"}}
          <span class="badge status-cancelled">{{.State}}</span>
          {{else if .State}}
          <span class="badge">{{.State}}</span>
          {{else}}
          <span class="muted">—</span>
          {{end}}
          {{if .IsDraft}} <span class="badge">draft</span>{{end}}
        </td>
        <td class="mono muted">{{if and .Owner .Repo}}{{.Owner}}/{{.Repo}}{{else}}—{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
</div>
{{end}}

{{if .IssueTasklist}}
<div class="section card" id="issue-breakdown">
  <h2>Breakdown <span class="muted" style="font-weight:500;font-size:0.9rem">{{.TasklistDone}}/{{.TasklistTotal}}</span></h2>
  <ul class="issue-tasklist" style="list-style:none;margin:0;padding:0;">
  {{range .IssueTasklist}}
    <li class="issue-tasklist-item" style="display:flex;align-items:flex-start;gap:0.5rem;padding:0.35rem 0;border-bottom:1px solid var(--border);">
      <span class="badge {{if .Checked}}status-done{{else}}muted{{end}}" style="flex-shrink:0;min-width:1.5rem;text-align:center" title="{{if .Checked}}done{{else}}open{{end}}">{{if .Checked}}✓{{else}}○{{end}}</span>
      <span style="flex:1;min-width:0">{{.Text}}</span>
      <span style="flex-shrink:0">
      {{if .ThreadID}}
        <a class="btn btn-compact btn-secondary" href="/sessions/{{.ThreadID}}?project={{urlquery $.Project}}&amp;back={{urlquery $.IssueBackURL}}">session</a>
      {{else if $.CanPlanFeature}}
        <form method="post" action="/projects/{{$.Project}}/issues/{{$.Issue.Number}}/items/start" style="display:inline;margin:0">
          {{template "csrf" $}}
          <input type="hidden" name="owner" value="{{$.ActiveOwner}}">
          <input type="hidden" name="repo" value="{{$.ActiveRepo}}">
          <input type="hidden" name="raw_line" value="{{.RawLine}}">
          <button type="submit" class="btn btn-compact btn-secondary"
            data-confirm="Start a session for: {{.Text}}?"
            data-confirm-title="Start checklist item"
            data-confirm-ok="Start session">Start session</button>
        </form>
      {{end}}
      </span>
    </li>
  {{end}}
  </ul>
  <p class="rail-note">Items come from the issue body's GitHub tasklist. Starting one links the new session on that line.</p>
</div>
{{end}}

{{if .IssueSessions}}
<div class="section card" id="issue-sessions">
  <h2>Sessions ({{len .IssueSessions}})</h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th>Goal</th><th>Status</th><th>Owner</th></tr></thead>
    <tbody>
    {{range .IssueSessions}}
      <tr>
        <td>
          <a href="/sessions/{{.ThreadID}}?project={{urlquery $.Project}}&amp;back={{urlquery $.IssueBackURL}}">{{if .Goal}}{{.Goal}}{{else}}{{.ThreadID}}{{end}}</a>
        </td>
        <td>
          {{if eq .Label "done"}}
          <span class="badge status-done">done</span>
          {{else if eq .Label "abandoned"}}
          <span class="badge status-cancelled">abandoned</span>
          {{else if eq .Label "needs_review"}}
          <span class="badge status-warn">needs review</span>
          {{else if eq .Label "in_progress"}}
          <span class="badge live">in progress</span>
          {{else if eq .Label "blocked"}}
          <span class="badge status-warn">blocked</span>
          {{else if .Label}}
          <span class="badge">{{.Label}}</span>
          {{else}}
          <span class="muted">—</span>
          {{end}}
          {{if .Busy}} · running{{end}}
          {{if gt .QueueLen 0}} · queued ({{.QueueLen}}){{end}}
        </td>
        <td>{{if .OwnerName}}{{.OwnerName}}{{else if .OwnerID}}<span class="muted">{{.OwnerID}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  <p class="rail-note">Sessions bind this issue when their prompt mentions it or a fix is dispatched from here.</p>
</div>
{{end}}

<div class="section">
  <h2>Comments <span class="muted" style="font-weight:500;font-size:0.9rem">({{len .Issue.Comments}})</span></h2>
  {{range .Issue.Comments}}
  <div class="card" style="margin-bottom:0.75rem;">
    <div class="muted mono" style="font-size:0.85rem;">{{.Author}}</div>
    {{if .Body}}<div class="md" style="margin-top:0.5rem">{{markdown .Body}}</div>{{end}}
  </div>
  {{else}}
  <div class="empty">No comments.</div>
  {{end}}
</div>

</div>{{/* /pr-main */}}

{{template "rail_scrim" $}}
<aside class="pr-rail" id="page-rail">
{{template "rail_sheet_head" $}}

{{if .CanStartSession}}
<div class="rail-group" id="issue-fix-form">
  <div class="rail-group-title">Agent</div>
  {{if .ShowFixPicker}}
  <p class="rail-note">Multiple sessions bind this issue — continue one:</p>
  {{range .FixHits}}
  <div class="grok-pick">
    <div class="grok-pick-head">
      <span class="badge">{{.Label}}</span>
      {{if .Busy}}<span class="badge live">busy</span>{{end}}
      <a class="tid mono" href="/sessions/{{.ThreadID}}{{if $.Project}}?project={{urlquery $.Project}}{{end}}">{{.ThreadID}}</a>
    </div>
    {{if .Goal}}<div class="grok-pick-goal">{{.Goal}}</div>{{end}}
    <form method="post" action="/projects/{{$.Project}}/issues/{{$.Issue.Number}}/fix" class="grok-pick-actions">
      {{template "csrf" $}}
      <input type="hidden" name="owner" value="{{$.ActiveOwner}}">
      <input type="hidden" name="repo" value="{{$.ActiveRepo}}">
      <input type="hidden" name="thread_id" value="{{.ThreadID}}">
      <button type="submit" class="btn-secondary btn-compact">Continue</button>
    </form>
  </div>
  {{else}}
  <p class="rail-note">No sessions available to continue.</p>
  {{end}}
  <p class="rail-note">Or start a new session:</p>
  {{end}}
  <form method="post" action="/projects/{{.Project}}/issues/{{.Issue.Number}}/fix" class="grok-dispatch">
    {{template "csrf" $}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    {{if .ShowFixPicker}}
    <input type="hidden" name="force_new" value="1">
    {{else}}
    <label class="check"><input type="checkbox" name="force_new" value="1"> Always start a new session</label>
    {{end}}
    <div class="form-actions"><button type="submit" id="btn-fix-github">Fix with Grok</button></div>
  </form>
  <p class="rail-note">Starts or reuses a session for this issue. Grok opens or updates a PR; it never merges.</p>
  {{if .CanPlanFeature}}
  <form method="post" action="/projects/{{.Project}}/issues/{{.Issue.Number}}/plan" class="grok-dispatch" style="margin-top:0.75rem">
    {{template "csrf" $}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    <div class="form-actions">
      {{if .IssueTasklist}}
      <button type="submit" id="btn-plan-feature" class="btn-secondary"
        data-confirm="Re-plan will rewrite the Breakdown section on this issue. Continue?"
        data-confirm-title="Re-plan feature"
        data-confirm-ok="Re-plan">Re-plan</button>
      {{else}}
      <button type="submit" id="btn-plan-feature">Plan this feature</button>
      {{end}}
    </div>
  </form>
  <p class="rail-note">{{if .IssueTasklist}}Re-writes the Breakdown tasklist on the issue.{{else}}Starts a session that writes a tasklist breakdown onto the issue.{{end}} Does not implement code.</p>
  {{end}}
</div>
{{end}}

{{if .CanGitHubWrite}}
<div class="rail-group" id="issue-comment-form">
  <div class="rail-group-title">GitHub</div>
  <details class="action">
    <summary><span class="action-title">Add comment</span></summary>
    <div class="action-body">
      <form method="post" action="/projects/{{.Project}}/issues/{{.Issue.Number}}/comments">
        {{template "csrf" $}}
        <input type="hidden" name="owner" value="{{.ActiveOwner}}">
        <input type="hidden" name="repo" value="{{.ActiveRepo}}">
        <div class="field">
          <label for="issue-body">Comment</label>
          <textarea id="issue-body" name="body" rows="4" required></textarea>
        </div>
        <div class="form-actions">
          <button type="submit">Post comment</button>
          {{if $open}}
          <button type="submit" class="btn-danger" id="btn-issue-close"
            formaction="/projects/{{.Project}}/issues/{{.Issue.Number}}/close"
            data-confirm="Post this comment and close the issue?" data-confirm-title="Close issue" data-confirm-ok="Post &amp; close">Post comment &amp; close</button>
          {{end}}
        </div>
      </form>
    </div>
  </details>
</div>
{{end}}

{{if not (or .CanStartSession .CanGitHubWrite)}}
<div class="rail-group">
  <div class="rail-group-title">Actions</div>
  <p class="rail-note">Read-only access — Grok dispatch and GitHub writes need a member role with web features enabled.</p>
</div>
{{end}}

</aside>
</div>{{/* /pr-cols */}}
{{end}}
