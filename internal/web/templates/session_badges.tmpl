{{/* Shared session-row badges — sessions list, Today, and project overview.
     session_pr_links emits anchors; session_pr_chips emits spans so a row
     that is itself an <a> can still show PR state. */}}
{{define "prBadgeClass"}}{{if .Failing}} status-error{{else if eq .State "MERGED"}} status-merged{{else if eq .State "CLOSED"}} status-cancelled{{else if eq .State "OPEN"}} live{{end}}{{end}}
{{define "prBadgeLabel"}}{{if .Failing}}CI failing{{else}}{{.State}}{{end}}{{end}}
{{define "session_pr_links"}}
{{$project := .Project}}
{{range .PRs}}{{if .Number}}{{if and .Owner .Repo}}<a class="badge{{template "prBadgeClass" .}}" title="{{.Owner}}/{{.Repo}}#{{.Number}}" href="/prs/{{.Owner}}/{{.Repo}}/{{.Number}}{{if $project}}?project={{urlquery $project}}{{end}}">#{{.Number}}{{if or .Failing .State}} · {{template "prBadgeLabel" .}}{{end}}</a>{{else if .URL}}<a class="badge{{template "prBadgeClass" .}}" href="{{.URL}}" target="_blank" rel="noopener">#{{.Number}}{{if or .Failing .State}} · {{template "prBadgeLabel" .}}{{end}} ↗</a>{{else}}<span class="badge{{template "prBadgeClass" .}}">#{{.Number}}{{if or .Failing .State}} · {{template "prBadgeLabel" .}}{{end}}</span>{{end}}{{end}}{{end}}
{{end}}
{{define "session_pr_chips"}}
{{range .PRs}}{{if .Number}}<span class="badge{{template "prBadgeClass" .}}">#{{.Number}}{{if or .Failing .State}} · {{template "prBadgeLabel" .}}{{end}}</span>{{end}}{{end}}
{{end}}
{{define "session_row_state"}}
{{if and (eq .Mode "case") (eq .Phase "closed")}}
<span class="badge status-cancelled">closed</span>
{{if .Resolution}}{{if or (eq .Resolution "answered") (eq .Resolution "fixed")}}<span class="badge status-done">{{.Resolution}}</span>{{else}}<span class="badge status-cancelled">{{.Resolution}}</span>{{end}}{{end}}
{{else if eq .Label "done"}}
<span class="badge status-done">done</span>
{{else if eq .Label "abandoned"}}
<span class="badge status-cancelled">abandoned</span>
{{else if eq .Label "needs_review"}}
<span class="badge status-warn">needs review</span>
{{else if eq .Label "in_progress"}}
<span class="badge live">in progress</span>
{{else if eq .Label "blocked"}}
<span class="badge status-warn">blocked</span>
{{else if .Label}}
<span class="badge">{{.Label}}</span>
{{else if .Phase}}
<span class="badge">{{.Phase}}</span>
{{else}}
<span class="muted">—</span>
{{end}}
{{if and (eq .Mode "case") (ne .Phase "closed") .Phase}}<span class="badge">{{.Phase}}</span>{{end}}
{{if .Running}}<span class="badge live">running</span>{{end}}
{{if eq .SessionKind "imported_pr"}}<span class="badge">imported</span>{{end}}
{{end}}
