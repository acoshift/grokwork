{{define "content"}}
<div class="config-sub" id="page-config-worktrees">
{{template "config_sub_header" $}}
<h1>Worktrees</h1>
<p class="sub">
  A git worktree is created for each session, under <span class="mono">&lt;root&gt;/&lt;project&gt;/&lt;sessionId&gt;</span>.
  Absolute path recommended; relative paths resolve against the config file directory.
  Existing sessions keep their stored path until reset.
</p>
<div class="section card">
  <form class="inline" method="post" action="{{route "config.worktrees"}}" style="grid-template-columns: 2fr 1fr 1fr auto;">
    {{template "csrf" $}}
    <div>
      <label for="worktree-dir">Worktree folder</label>
      <input id="worktree-dir" type="text" name="worktreeDir" value="{{.Config.WorktreeDir}}" placeholder="empty = data/worktrees" autocomplete="off" spellcheck="false">
    </div>
    <div>
      <label for="worktree-idle-ttl">Worktree idle TTL (days)</label>
      <input id="worktree-idle-ttl" type="number" name="worktreeIdleTTLDays" min="0" step="1" required value="{{.Config.WorktreeIdleTTLDays}}" autocomplete="off">
    </div>
    <div>
      <label for="terminal-session-ttl">Done/abandoned TTL (days)</label>
      <input id="terminal-session-ttl" type="number" name="terminalSessionTTLDays" min="0" step="1" required value="{{.Config.TerminalSessionTTLDays}}" autocomplete="off">
    </div>
    <button type="submit">Save</button>
  </form>
  <p class="sub" style="margin:0.5rem 0 0">
    Idle TTL prunes after that many days without activity (default <span class="mono">30</span>);
    done/abandoned TTL deletes terminal sessions that long after their last update (default off).
    <span class="mono">0</span> disables either.
  </p>
  <p class="sub" style="margin:0.5rem 0 0">Effective root for new worktrees: <span class="mono">{{.Config.WorktreesRoot}}</span></p>
</div>
</div>
{{end}}
