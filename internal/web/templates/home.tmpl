{{define "content"}}
<h1 id="page-home">Projects</h1>
<p class="sub">Pick a project to work inside its scope — runs, PRs, issues, commits, and worktrees.</p>

{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{/* .badge sets display:inline-flex, which would otherwise beat [hidden]. */}}
<style>
  .proj-card-stats > [data-home-stat][hidden] { display: none; }
</style>
{{/* hx-target/hx-select override shell boost (#live-root) so SSE partials swap into the region, not wipe the page.
     hx-swap=none: counts are JSON painted in place; remounting the grid dropped focus and replayed enter animation.
     hx-sync queue last (not replace): SSE can tick every 2s while a run is active; replace aborts the
     in-flight XHR and htmx console.errors htmx:sendAbort / htmx:afterRequest on every abort. */}}
<div class="live-region"
     id="live-home-projects"
     data-home-counts
     hx-get="{{route "partial.home.counts"}}"
     hx-trigger="sse:dashboard, sse:ship, sse:history"
     hx-target="this"
     hx-select="unset"
     hx-swap="none"
     hx-sync="this:queue last">
  {{template "home_projects" .}}
</div>

{{/* Phone-only: Worktrees has no bottom tab (five max), so the global
     board keeps a drill-in row here. Desktop reaches it from the sidebar. */}}
<div class="section m-only" id="m-lead-views">
  <h2>Lead views</h2>
  <div class="m-rows">
    <a class="m-row" href="{{route "worktrees"}}">
      <span class="m-row-main">
        <span class="m-row-t">Worktrees</span>
        <span class="m-row-s">per-session checkouts · idle cleanup · prune</span>
      </span>
    </a>
    {{if .IsAdmin}}
    <a class="m-row" href="{{route "config"}}">
      <span class="m-row-main">
        <span class="m-row-t">Config</span>
        <span class="m-row-s">bot · runtime · automation · projects</span>
      </span>
    </a>
    {{end}}
  </div>
</div>

<div class="section">
  <h2>Now running</h2>
  <div class="live-region"
       id="live-home-runs"
       hx-get="{{route "partial.home.runs"}}"
       hx-trigger="sse:dashboard"
       hx-target="this"
       hx-select="unset"
       hx-swap="innerHTML"
       hx-sync="this:queue last">
    {{template "home_runs" .}}
  </div>
</div>
<script>
(function () {
  function homeStatText(key, n) {
    if (key === "running") return n + " running";
    if (key === "queued") return n + " queued";
    if (key === "openPRs") return n + " open PR" + (n === 1 ? "" : "s");
    if (key === "checksFailing") return n + " CI failing";
    if (key === "idle") return "idle";
    return String(n);
  }
  function num(v) {
    var n = Number(v);
    if (!isFinite(n) || n < 0) return 0;
    return Math.floor(n);
  }
  function applyHomeCounts(data) {
    if (!data || typeof data !== "object") return;
    document.querySelectorAll("[data-home-counts] .proj-card[data-project]").forEach(function (card) {
      var name = card.getAttribute("data-project");
      if (!Object.prototype.hasOwnProperty.call(data, name)) return;
      var counts = data[name];
      if (!counts || typeof counts !== "object") return;
      var running = num(counts.running);
      var queued = num(counts.queued);
      var openPRs = num(counts.openPRs);
      var failing = num(counts.checksFailing);
      var idle = running === 0 && queued === 0 && openPRs === 0;
      card.querySelectorAll("[data-home-stat]").forEach(function (el) {
        var key = el.getAttribute("data-home-stat");
        if (key === "idle") {
          el.hidden = !idle;
          return;
        }
        var n = key === "running" ? running : key === "queued" ? queued : key === "openPRs" ? openPRs : key === "checksFailing" ? failing : 0;
        if (n <= 0) {
          el.hidden = true;
          el.textContent = "";
          return;
        }
        el.hidden = false;
        el.textContent = homeStatText(key, n);
      });
    });
  }
  function countsPath(d) {
    var raw = "";
    if (d) {
      if (d.xhr && d.xhr.responseURL) raw = d.xhr.responseURL;
      else if (d.pathInfo) raw = d.pathInfo.finalRequestPath || d.pathInfo.requestPath || "";
      else if (d.requestConfig) raw = d.requestConfig.path || "";
    }
    try { return new URL(raw, location.origin).pathname; }
    catch (err) { return raw; }
  }
  function parseCountsJSON(d) {
    if (!d || !d.xhr) return null;
    if (d.successful === false) return null;
    var st = d.xhr.status;
    if (st < 200 || st >= 300) return null;
    try { return JSON.parse(d.xhr.responseText); }
    catch (err) { return null; }
  }
  function onHomeCountsLoaded(e) {
    if (countsPath(e.detail || {}) !== "/partials/home/counts") return;
    applyHomeCounts(parseCountsJSON(e.detail || {}));
  }
  if (!window.__gwHomeCountsBound) {
    window.__gwHomeCountsBound = true;
    document.body.addEventListener("htmx:afterOnLoad", onHomeCountsLoaded);
    document.body.addEventListener("htmx:afterRequest", onHomeCountsLoaded);
  }
  var host = document.querySelector("[data-home-counts]");
  if (!host) return;
  var url = host.getAttribute("hx-get") || "/partials/home/counts";
  fetch(url, {
    credentials: "same-origin",
    cache: "no-store",
    headers: { Accept: "application/json" }
  }).then(function (r) { return r.ok ? r.json() : null; })
    .then(function (data) {
      if (!document.querySelector("[data-home-counts]")) return;
      applyHomeCounts(data);
    }).catch(function () {});
})();
</script>
{{end}}

{{define "home_projects"}}
<div class="proj-grid" id="proj-grid">
  {{range .ProjectCards}}
  <a class="proj-card" href="/projects/{{.Name}}" data-project="{{.Name}}">
    <span class="proj-card-head">
      <span class="proj-mark" aria-hidden="true">{{printf "%.1s" .Name}}</span>
      <span class="proj-card-name">{{.Name}}</span>
    </span>
    <span class="proj-card-stats">
      <span class="badge live" data-home-stat="running"{{if eq .Running 0}} hidden{{end}}>{{if gt .Running 0}}{{.Running}} running{{end}}</span>
      <span class="badge" data-home-stat="queued"{{if eq .Queued 0}} hidden{{end}}>{{if gt .Queued 0}}{{.Queued}} queued{{end}}</span>
      <span class="badge" data-home-stat="openPRs"{{if eq .OpenPRs 0}} hidden{{end}}>{{if gt .OpenPRs 0}}{{.OpenPRs}} open PR{{if gt .OpenPRs 1}}s{{end}}{{end}}</span>
      <span class="badge status-error" data-home-stat="checksFailing"{{if eq .ChecksFailing 0}} hidden{{end}}>{{if gt .ChecksFailing 0}}{{.ChecksFailing}} CI failing{{end}}</span>
      <span class="badge" data-home-stat="idle"{{if not (and (eq .Running 0) (eq .Queued 0) (eq .OpenPRs 0))}} hidden{{end}}>idle</span>
    </span>
    <span class="proj-card-foot">
      <span>{{if .LastActivity}}{{.Sessions}} session{{if ne .Sessions 1}}s{{end}} · {{.LastActivity}}{{else}}no activity yet{{end}}</span>
      <span class="open-arrow">Open →</span>
    </span>
  </a>
  {{end}}
  {{if not .ProjectCards}}
  <div class="empty" id="home-empty" style="grid-column: 1 / -1;">
    No projects yet.{{if .IsAdmin}} Add one on <a href="{{route "config"}}">Config</a> to start working.{{end}}
  </div>
  {{end}}
</div>
{{end}}

{{define "home_runs"}}
<div id="runs-wrap">
  {{if .Status.ActiveRuns}}
  <div class="m-rows">
    {{range .Status.ActiveRuns}}
    <a class="m-row" href="/sessions/{{.ThreadID}}{{if .Project}}?project={{urlquery .Project}}{{end}}">
      <span class="m-row-main">
        <span class="m-row-t mono">{{.ThreadID}}</span>
        <span class="m-row-s">{{if .Project}}{{.Project}} · {{end}}running {{.Elapsed}}</span>
      </span>
      {{if gt .QueueLen 0}}<span class="badge">{{.QueueLen}} queued</span>{{else}}<span class="badge live">live</span>{{end}}
    </a>
    {{end}}
  </div>
  <div class="table-scroll m-hide">
  <table id="runs-table">
    <thead>
      <tr><th>Session</th><th>Project</th><th>Elapsed</th><th>Queue</th></tr>
    </thead>
    <tbody id="runs-body">
      {{range .Status.ActiveRuns}}
      <tr>
        <td class="mono"><a class="tid" href="/sessions/{{.ThreadID}}{{if .Project}}?project={{urlquery .Project}}{{end}}">{{.ThreadID}}</a></td>
        <td>{{if .Project}}<a href="/projects/{{.Project}}">{{.Project}}</a>{{else}}<span class="muted">—</span>{{end}}</td>
        <td class="mono">{{.Elapsed}}</td>
        <td>{{if gt .QueueLen 0}}<span class="badge">{{.QueueLen}} queued</span>{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
  {{else}}
  <div class="empty" id="runs-empty">No active runs. Open a project to start a task, or tag <span class="mono">@Grok</span> in a mapped Discord channel.</div>
  {{end}}
</div>
{{end}}
