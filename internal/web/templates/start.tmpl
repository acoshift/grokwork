{{define "content"}}
<h1 id="page-start">{{.Project}} <span class="muted" style="font-weight:500;font-size:0.95rem">· start task</span></h1>
<p class="sub">Describe the work and Grok runs it on a fresh worktree, streaming into a new session.</p>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{if .CanStartSession}}
{{/* Form stays out of any live region — this page has none — so nothing wipes typed text. */}}
<div class="section card" id="start-form">
  <form class="stack" method="post" action="/projects/{{.Project}}/start" enctype="multipart/form-data">
    {{template "csrf" $}}
    <div class="field">
      <label for="start-title">Title <span class="muted">(optional)</span></label>
      <input type="text" id="start-title" name="title" placeholder="Short summary — auto-generated from the task if blank">
    </div>
    <div class="field">
      <label for="start-prompt">Task</label>
      <textarea id="start-prompt" name="prompt" rows="8" required placeholder="Describe what Grok should do…"></textarea>
    </div>
    <div class="field">
      <label for="start-images">Files <span class="muted">(optional)</span></label>
      <input type="file" id="start-images" name="images" multiple data-attach-chips="start-attach-chips">
      <div class="attach-chips" id="start-attach-chips" hidden></div>
      <p class="rail-note" style="margin-top:0.4rem">Files (images, PDFs, …) are handed to the run (same as Discord attachments).</p>
    </div>
    <div class="field">
      <label for="start-mode">Mode</label>
      <select id="start-mode" name="mode">
        {{if .CanStartFixMode}}
          {{if eq .StartDefaultMode "fix"}}<option value="">Fix &amp; ship (default)</option>{{else}}<option value="">Project default ({{.StartDefaultMode}})</option>
          <option value="fix">Fix &amp; ship</option>{{end}}
          <option value="investigate">Investigate</option>
          <option value="explain">Explain</option>
          <option value="plan">Plan</option>
        {{else}}
          <option value="investigate" selected>Investigate</option>
          <option value="explain">Explain</option>
        {{end}}
      </select>
      {{if .CanStartFixMode}}
      <p class="rail-note" style="margin-top:0.4rem">Investigate never opens PRs or ships. Plan reads the repo, asks if needed, then opens a GitHub issue labelled <span class="mono">plan</span> — no code edits, no PR.</p>
      {{else}}
      <p class="rail-note" style="margin-top:0.4rem">Fix &amp; ship and Plan require builder-class project caps (<span class="mono">startSessions</span> + <span class="mono">githubWrites</span>). Investigate never opens PRs or ships.</p>
      {{end}}
    </div>
    {{if .CanSelectModel}}
    <div class="field">
      <label for="start-model">Model</label>
      <select id="start-model" name="model" data-model-limits="start-model-limits">
        {{template "model_picker_options" $}}
      </select>
      <p class="rail-note" style="margin-top:0.4rem">The model picks the CLI, and the session keeps both for life.</p>
      <p class="model-limits" id="start-model-limits"{{if not .ModelDefaultLimits}} hidden{{end}}>{{.ModelDefaultLimits}}</p>
    </div>
    {{end}}
    <div class="form-actions"><button type="submit" id="btn-start">Start task</button></div>
  </form>
</div>
{{else}}
<div class="section card">
  <p class="rail-note">Read-only access — starting a task needs a member role with <span class="mono">startSessions</span> enabled.</p>
</div>
{{end}}

<div class="section card" id="start-context">
  <h2>What happens</h2>
  <p class="sub" style="margin-top:0">
    Ship mode is set in
    {{if .IsAdmin}}<a href="/config/projects/{{.Project}}">project settings</a>{{else}}project settings{{end}}
    and stays fixed for the session.
  </p>
  {{if .CanStartFixMode}}
  <p class="sub" style="margin-top:0.35rem">
    When a run ships:
    {{if .StartDirectShip}}<span class="badge">Direct to primary</span> — Grok fast-forwards the project default branch and pushes; no PR.{{else}}<span class="badge">PR mode</span> — the session works on a managed branch and opens a pull request.{{end}}
  </p>
  {{if ne .StartDefaultMode "fix"}}<p class="sub" style="margin-top:0.35rem">Project default mode is <span class="mono">{{.StartDefaultMode}}</span>.</p>{{end}}
  {{end}}
  <p class="sub" style="margin-top:0.35rem">
    Destination:
    {{if .StartDiscordDest}}opens a Discord thread in this project's mapped channel.{{else}}streams here on this page.{{end}}
  </p>
</div>
{{end}}
