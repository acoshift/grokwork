{{define "content"}}
<h1 id="page-deploys">{{.Project}} <span class="muted" style="font-weight:500;font-size:0.95rem">· deploys</span></h1>
<p class="sub">
  {{if .ActiveRepo}}Repo: <span class="mono">{{.ActiveOwner}}/{{.ActiveRepo}}</span> · {{end}}
  {{if .DeployRef}}ref <span class="mono">{{.DeployRef}}</span>{{end}}
  {{if .DeployShortSHA}} · <span class="mono">{{.DeployShortSHA}}</span>{{end}}
  · <span class="mono">{{.DeployManifestPath}}</span>
</p>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{if gt (len .RepoCatalog) 1}}
{{/* No sync script: the handler parses repo_full itself (pickedRepo), so the
     picker works with scripting off. The commits browser mirrors its select
     into hidden inputs from JS instead, which silently ignores the selection
     when scripting is unavailable. */}}
<div class="toolbar" id="deploys-toolbar">
<form method="get" action="/projects/{{.Project}}/deploys" id="deploys-filter" style="display:contents">
  <div class="field" style="flex-basis:18rem">
    <label for="deploys-repo-pick">Repository</label>
    <select id="deploys-repo-pick" name="repo_full" data-autosubmit>
      {{range .RepoCatalog}}
      <option value="{{.Owner}}/{{.Repo}}" {{if and (eq .Owner $.ActiveOwner) (eq .Repo $.ActiveRepo)}}selected{{end}}>{{.Owner}}/{{.Repo}}</option>
      {{end}}
    </select>
  </div>
  <button type="submit" class="btn-secondary">Apply</button>
</form>
</div>
{{end}}

{{if .DeployNotConfigured}}
<div class="section">
  <h2>No pipeline yet</h2>
  <p class="sub">
    This repo has no <span class="mono">{{.DeployManifestPath}}</span> at
    <span class="mono">{{.DeployRef}}</span>. The pipeline lives in the repo so it
    is versioned with the code it deploys and reviewed like any other change;
    credentials and per-environment policy stay in project settings.
  </p>
  <p class="sub">Commit something like this to get started:</p>
  <pre class="mono">version: 1
environments: [dev, stag, prod]

services:
  api:
    dir: services/api
    steps:
      - name: build
        run: docker build -t $IMAGE_REPO/api:$GW_SHA .
        timeout: 20m
      - name: rollout
        run: kubectl -n $K8S_NAMESPACE set image deploy/api api=$IMAGE_REPO/api:$GW_SHA
    pipelines:
      prod:
        - name: verify-image
          run: docker manifest inspect $IMAGE_REPO/api:$GW_SHA
        - name: rollout
          run: kubectl -n $K8S_NAMESPACE set image deploy/api api=$IMAGE_REPO/api:$GW_SHA</pre>
  <p class="sub">
    <span class="mono">steps</span> is the default pipeline; a
    <span class="mono">pipelines.&lt;env&gt;</span> entry fully replaces it for that
    environment, and a step may carry <span class="mono">envs: [prod]</span> to run
    in some environments only.
  </p>
</div>
{{else if .DeployRows}}
<div class="section">
  <h2>Pipeline</h2>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Service</th>
        <th>Dir</th>
        {{range .DeployEnvs}}<th>{{.}}</th>{{end}}
      </tr>
    </thead>
    <tbody>
    {{range .DeployRows}}
      <tr>
        <td class="mono">{{.Service}}</td>
        <td class="mono muted">{{.Dir}}</td>
        {{range .Cells}}
        <td>
          {{if .Deployable}}<span class="flag ok">{{len .Steps}} step{{if ne (len .Steps) 1}}s{{end}}</span>
          {{else}}<span class="muted" title="{{.Reason}}">—</span>{{end}}
        </td>
        {{end}}
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  <p class="sub">
    Resolved from the manifest at <span class="mono">{{.DeployRef}}</span>.
  </p>
</div>

{{if .DeployRows}}
{{/* Trigger forms sit OUTSIDE any live region on purpose. The confirm handler
     bails on a detached form (it checks isConnected) and the swap-pause hook
     only covers isEditing(), which an open dialog is not — so a confirmed prod
     deploy inside a live region can silently do nothing. */}}
<div class="section" id="deploy-trigger">
  <h2>Deploy</h2>
  {{if not .DeployEnabled}}
  <p class="sub">Deploys are not enabled for this project. Turn them on in
    <a href="/config/projects/{{.Project}}/deploy">project settings</a>.</p>
  {{else if not .DeployFeatureOn}}
  <p class="sub">Triggering is off: deploys need web auth and the
    <span class="mono">deploy</span> feature flag.</p>
  {{else}}
  <div class="rail-group">
  {{range .DeployRows}}
    {{$svc := .Service}}
    {{range .Cells}}
      {{if .Deployable}}
      {{$gated := index $.DeployEnvGated .Env}}
      <form method="post" action="/projects/{{$.Project}}/deploys" class="inline"
            style="grid-template-columns: 1fr 12rem auto;"
            data-confirm="Deploy {{$svc}} to {{.Env}} at {{$.DeployShortSHA}}? {{len .Steps}} step{{if ne (len .Steps) 1}}s{{end}} will run against {{.Env}}.{{if $gated}} If the branch has moved since this page loaded, the deploy is refused rather than shipping a different commit.{{end}}"
            data-confirm-title="Deploy {{$svc}} → {{.Env}}"
            data-confirm-ok="Deploy"
            {{if $gated}}data-confirm-danger="1"{{end}}>
        {{template "csrf" $}}
        <input type="hidden" name="service" value="{{$svc}}">
        <input type="hidden" name="env" value="{{.Env}}">
        <input type="hidden" name="owner" value="{{$.ActiveOwner}}">
        <input type="hidden" name="repo" value="{{$.ActiveRepo}}">
        <span><span class="mono">{{$svc}}</span> → <span class="mono">{{.Env}}</span></span>
        {{if $gated}}
        {{/* A protected environment deploys the exact commit shown here, not
             "whatever that ref points at by the time you click": the trigger
             fetches first, so the ref can legitimately move in between, and
             reviewing a specific commit is what the gate is for. expect_sha
             makes the server refuse a drifted deploy. To ship a different
             commit here, use Redeploy on a past run — it is SHA-pinned. */}}
        <input type="hidden" name="ref" value="{{$.DeployRef}}">
        <input type="hidden" name="expect_sha" value="{{$.DeploySHA}}">
        <span class="mono muted">{{$.DeployRef}} @ {{$.DeployShortSHA}}</span>
        {{else}}
        <input type="text" name="ref" value="{{$.DeployRef}}" class="mono" aria-label="Ref for {{$svc}} to {{.Env}}">
        {{end}}
        <button type="submit" class="{{if $gated}}btn-danger{{else}}btn-secondary{{end}}">Deploy</button>
      </form>
      {{end}}
    {{end}}
  {{end}}
  </div>
  {{end}}
</div>
{{end}}

{{if .DeployRecent}}
<div class="section">
  <h2>Recent runs</h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th>When</th><th>Service</th><th>Env</th><th>Commit</th><th>Status</th><th>By</th></tr></thead>
    <tbody>
    {{range .DeployRecent}}
      <tr>
        <td class="mono"><a href="/projects/{{$.Project}}/deploys/{{.ID}}">{{shortTime .QueuedAt}}</a></td>
        <td class="mono">{{.Service}}</td>
        <td class="mono">{{.Env}}</td>
        <td class="mono">{{.ShortSHA}}</td>
        <td>
          <span class="badge {{if eq .Status "succeeded"}}status-done{{else if eq .Status "failed"}}status-error{{else if eq .Status "running"}}live{{else}}status-warn{{end}}">{{.Status}}</span>
          {{if .SupersededBy}}<span class="muted" title="A later deploy replaced this one">superseded</span>{{end}}
        </td>
        <td>{{.ActorName}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>
</div>
{{end}}

{{range .DeployRows}}
<div class="section">
  <h2><span class="mono">{{.Service}}</span></h2>
  {{$svc := .Service}}
  <div class="rail-group">
  {{range .Cells}}
    {{if .Deployable}}
    <details class="action">
      <summary>
        <span class="action-title">{{$svc}} → {{.Env}}</span>
        <span class="muted">{{len .Steps}} step{{if ne (len .Steps) 1}}s{{end}}</span>
      </summary>
      <div class="action-body">
        <ol class="deploy-steps">
        {{range .Steps}}
          <li>
            <span class="mono">{{.Name}}</span>
            <span class="muted">· {{msDur .TimeoutMs}}</span>
            <pre class="mono">{{.Command}}</pre>
          </li>
        {{end}}
        </ol>
      </div>
    </details>
    {{end}}
  {{end}}
  </div>
</div>
{{end}}
{{end}}

{{/* Outside the branches on purpose: a manifest that fails to parse sets
     neither DeployNotConfigured nor DeployRows, and that is precisely when an
     agent should be offered. */}}
{{template "deploy_generate_form" .}}
{{end}}

{{define "deploy_generate_form"}}
{{if .CanGenerateManifest}}
{{/* An ordinary agent session: it writes the file and opens a PR, so the
     pipeline gets reviewed before it can govern a production deploy. Gated on
     startSessions rather than the deploy feature, so a project can write its
     pipeline before deploys are switched on. */}}
<div class="section card" id="deploy-generate">
  <h2>{{if .DeployNotConfigured}}Write this with an agent{{else}}Update with an agent{{end}}</h2>
  <p class="sub" style="margin-top:0">
    Starts a session that inspects the repo — Dockerfiles, existing CI deploy
    workflows, the directory layout — and writes
    <span class="mono">{{.DeployManifestPath}}</span>, then opens a PR for review.
    {{if .DeployEnvs}}It is told which environments this host has configured and
    which variable names their steps can use (never the values).{{end}}
  </p>
  <form method="post" action="/projects/{{.Project}}/deploys/generate">
    {{template "csrf" $}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    <div class="field">
      <label for="deploy-req">Additional requirements <span class="muted">(optional)</span></label>
      <textarea id="deploy-req" name="requirements" rows="5"
                placeholder="e.g. prod must promote the image built for stag rather than rebuilding; run migrations before rollout; the web app deploys to a GCS bucket behind a CDN"></textarea>
      <p class="rail-note" style="margin-top:0.4rem">
        Anything the repo cannot tell it: promotion rules, migration order, which
        services to skip, approvals your team expects. These take precedence over
        its own reading of the repo.
      </p>
    </div>
    {{if .CanSelectModel}}
    <div class="field">
      <label for="deploy-model">Model</label>
      <select id="deploy-model" name="model">
        {{template "model_picker_options" $}}
      </select>
      <p class="rail-note" style="margin-top:0.4rem">The model picks the CLI, and the session keeps both for life.</p>
    </div>
    {{end}}
    <div class="form-actions">
      <button type="submit">{{if .DeployNotConfigured}}Generate pipeline{{else}}Start update session{{end}}</button>
    </div>
  </form>
</div>
{{end}}
{{end}}
