{{define "content"}}
<p class="pr-crumb">
  <a href="/projects/{{.Project}}/commits?owner={{urlquery .ActiveOwner}}&amp;repo={{urlquery .ActiveRepo}}">← Commits</a>
  <span class="crumb-sep">/</span>
  <span class="mono">{{.ActiveOwner}}/{{.ActiveRepo}}{{if .Commit.ShortSHA}} @ {{.Commit.ShortSHA}}{{end}}</span>
</p>
<div class="pr-title-row">
  <h1 id="page-commit-detail">{{if .Commit.Subject}}{{.Commit.Subject}}{{else if .Commit.ShortSHA}}{{.Commit.ShortSHA}}{{else}}commit{{end}}</h1>
</div>
{{if .Commit.SHA}}
<div class="pr-meta">
  <span class="mono" title="{{.Commit.SHA}}">{{.Commit.SHA}}</span>
  {{if .Commit.AuthorName}}<span>{{.Commit.AuthorName}}{{if .Commit.AuthorEmail}} <span class="mono">&lt;{{.Commit.AuthorEmail}}&gt;</span>{{end}}</span>{{end}}
  {{if not .Commit.AuthorDate.IsZero}}<span class="mono">{{.Commit.AuthorDate.Format "2006-01-02 15:04 MST"}}</span>{{end}}
  {{with .DiffReview}}<span class="mono">{{if .TotalAdds}}<span class="diff-add">+{{.TotalAdds}}</span> {{end}}{{if .TotalDels}}<span class="diff-del">−{{.TotalDels}}</span> · {{end}}{{len .Files}} files</span>{{end}}
</div>
{{end}}
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
{{if .Error}}<div class="flash err">{{.Error}}</div>{{end}}

{{if .Commit.SHA}}
<div class="pr-cols">
<div class="pr-main">

<div class="section card">
  <h2>Message</h2>
  {{if .Commit.Body}}
  <pre class="bubble-body" style="margin:0;white-space:pre-wrap;">{{.Commit.Body}}</pre>
  {{else}}
  <p class="muted" style="margin:0">No extended message.</p>
  {{end}}
</div>

</div>{{/* /pr-main */}}

{{template "rail_scrim" $}}
<aside class="pr-rail" id="page-rail">
{{template "rail_sheet_head" $}}

<div class="rail-group" id="commit-review-actions">
  <div class="rail-group-title">Agent</div>
  {{if .CanReviewCommit}}
  {{/* The model select is hidden: it exists so the confirm modal can clone its
       options, and so the form still posts a default with scripting off. */}}
  <form method="post" action="/projects/{{.Project}}/commits/{{.Commit.SHA}}/review" class="grok-dispatch" hx-boost="false"
    {{- if .CanSelectModel}} data-confirm="Reviews this commit in a new session and files an issue per confirmed finding." data-confirm-title="Review commit" data-confirm-ok="Start review" data-confirm-select="model" data-confirm-select-label="Review model"{{end}}>
    {{template "csrf" .}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    {{if .CanSelectModel}}<select name="model" hidden>{{template "model_picker_options" $}}</select>{{end}}
    <div class="form-actions"><button type="submit">Review in new session</button></div>
  </form>
  <p class="rail-note">The agent reviews the commit with full tools and files a GitHub issue per confirmed finding.</p>
  {{else}}
  <p class="rail-note">Requires member role with <span class="mono">startSessions</span> enabled.</p>
  {{end}}
</div>

{{if .CanCherryPick}}
{{if .ForcePushTargets}}
<div class="rail-group" id="commit-cherrypick-actions">
  <div class="rail-group-title">Force-push</div>
  <form method="post" action="/projects/{{.Project}}/commits/force-push" class="grok-dispatch" hx-boost="false"
    data-confirm="Moves the target branch to this commit and pushes. Fast-forward when possible; otherwise force-with-lease. Commits only on the target disappear from that branch. It does not start an agent and does not merge a PR."
    data-confirm-title="Force-push to branch" data-confirm-ok="Force-push" data-confirm-danger
    data-confirm-select="target" data-confirm-select-label="Target branch"
    data-confirm-wait="Updating the target branch…">
    {{template "csrf" .}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    <input type="hidden" name="sha" value="{{.Commit.SHA}}">
    {{/* Hidden: the confirm modal clones its options. Scripting off posts the first target. */}}
    <select name="target" hidden>{{range .CherryPickTargets}}<option value="{{.}}">{{.}}</option>{{end}}</select>
    <div class="form-actions"><button type="submit">Force-push</button></div>
  </form>
  <p class="rail-note">Moves the target branch to this commit. Fast-forward when possible; otherwise force-with-lease. It does not start an agent and does not merge a PR.</p>
</div>
{{else}}
<div class="rail-group" id="commit-cherrypick-actions">
  <div class="rail-group-title">Cherry-pick</div>
  <form method="post" action="/projects/{{.Project}}/commits/cherrypick" class="grok-dispatch" hx-boost="false"
    data-confirm="Cherry-picks this commit onto the target branch and pushes. It does not start an agent, does not force-push, and does not merge a PR."
    data-confirm-title="Cherry-pick to branch" data-confirm-ok="Cherry-pick" data-confirm-danger
    data-confirm-select="target" data-confirm-select-label="Target branch"
    data-confirm-wait="Cherry-picking onto the target branch…">
    {{template "csrf" .}}
    <input type="hidden" name="owner" value="{{.ActiveOwner}}">
    <input type="hidden" name="repo" value="{{.ActiveRepo}}">
    <input type="hidden" name="sha" value="{{.Commit.SHA}}">
    {{/* Hidden: the confirm modal clones its options. Scripting off posts the first target. */}}
    <select name="target" hidden>{{range .CherryPickTargets}}<option value="{{.}}">{{.}}</option>{{end}}</select>
    <div class="form-actions"><button type="submit">Cherry-pick</button></div>
  </form>
  <p class="rail-note">Applies this commit onto the target branch and pushes. It does not start an agent, does not force-push, and does not merge a PR.</p>
</div>
{{end}}
{{end}}

</aside>
</div>{{/* /pr-cols */}}

<div class="section">
  {{template "diff_review" .}}
</div>
{{end}}
{{end}}
