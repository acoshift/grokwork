{{define "content"}}
<div id="page-today">
  <h1>{{if .Project}}{{.Project}} <span class="muted" style="font-weight:500;font-size:0.95rem">· today</span>{{else}}Today{{end}}</h1>
  <p class="sub">What still needs you — SLA, unanswered decisions, failing CI, team reviews. Inbox is the log of what happened.{{if gt .InboxUnread 0}} <a href="{{route "inbox"}}">{{.InboxUnread}} unread in Inbox</a>.{{end}}</p>
  <div class="live-region"
       id="live-today"
       hx-get="{{route "partial.today.list"}}?project={{urlquery .Waiting.Project}}{{if .Project}}&amp;scoped=1{{end}}"
       hx-trigger="sse:ship, sse:cases, sse:history, sse:inbox"
       hx-target="this"
       hx-select="unset"
       hx-swap="innerHTML show:none focus-scroll:false">
    {{template "today_list" .}}
  </div>
</div>
{{end}}

{{define "today_list"}}
{{if gt .Waiting.Matched .Waiting.Shown}}
<p class="muted">Showing {{.Waiting.Shown}} of {{.Waiting.Matched}}.</p>
{{end}}
<div class="card-list" id="today-list">
{{range .Waiting.Rows}}
  <article class="card">
    <header class="meta">
      {{range .Reasons}}<span class="badge">{{.}}</span>{{end}}
      {{if not $.Project}}{{if .Project}}<span class="mono">{{.Project}}</span>{{end}}{{end}}
      {{if .CaseKey}}<span class="mono">{{.CaseKey}}</span>{{end}}
      {{if .UpdatedAt}}<span class="muted mono">{{relativeAge .UpdatedAt}}</span>{{end}}
    </header>
    <div>
      {{if .URL}}<a href="{{.URL}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}
    </div>
    {{if .DecisionText}}<div class="muted">{{.DecisionText}}</div>{{end}}
  </article>
{{else}}
  <div class="empty">Nothing needs you.{{if not $.UserID}} Sign in to see your queue.{{end}} <a href="{{route "inbox"}}">Inbox</a> · <a href="{{route "home"}}">Projects</a></div>
{{end}}
</div>
{{end}}
